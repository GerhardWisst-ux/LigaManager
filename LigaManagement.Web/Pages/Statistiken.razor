                                var SpieltageHH = Spieltage.Where(x => x.Tore1_Nr > x.Tore2_Nr).OrderByDescending(x => x.Tore1_Nr - x.Tore2_Nr).ThenByDescending(x => x.Datum).Take(50).ToList();

                                @if (Spieltage.Count() == 0)
                                {
                                    <RadzenStack AlignItems="AlignItems.Center" Class="rz-m-12" Gap="2rem">
                                        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                                    </RadzenStack>
                                }
                                else
                                {
                                    <RadzenDataGrid @ref="grid" Data="@SpieltageHH" EmptyText="@Localizer["Keine Ergebnisse zum Anzeigen"].Value" class="table table-striped" FilterMode="FilterMode.Advanced" PageSize="12"
