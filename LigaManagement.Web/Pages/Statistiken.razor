@page "/Ligamanager/statistiken"
@using LigaManagerManagement.Web.Pages;
@using Microsoft.EntityFrameworkCore
@inherits StatistikenListBase
@inject LigaManagerManagement.Web.Services.LigaManagerAuthenticationStateProvider _LigaManagerAuthenticationStateProvider
@attribute [Authorize]

<head>


</head>

<script>
    function scrollToTop() {
        window.scrollTo(0, 0);
    }
</script>

<style type="text/css">

    .rz-datatable tr {
        min-height: 8%;
        word-break: break-all;
    }

    tr.separated td {
        /* set border style for separated rows */
        border-bottom: 1px solid black;
    }

    table {
        /* make the border continuous (without gaps between columns) */
        border-collapse: collapse;
    }

    .rz-datatable td {
        padding: 2.5px;
    }
</style>


<div class="container">
    <RadzenCard class="m-0 rz-shadow-3" style="height:120px;">
        <div class="d-flex flex-row">
            <div class="card-body">
                <span style="color:#1151f3; background-color:transparent;" class="float-right">@Localizer["Eingeloggter Benutzer"].Value: @_LigaManagerAuthenticationStateProvider.CurrentUser.Username</span>
                <br />
                <NavLink href="@($"Ligamanager/account/logout")" style="margin-top:8px;" title="@Localizer["Ausloggen"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="logout" /><span></span></div></NavLink>
                <NavLink href="@($"Ligamanager/einstellungen")" style="margin-top:8px;" title="@Localizer["Einstellungen"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="settings" /><span></span></div></NavLink>
                <NavLink href="@($"Ligamanager/info")" style="margin-top:8px;" title="@Localizer["Info"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="info" /><span></span></div></NavLink>
                <NavLink href="@($"InfoTexteList")" style="margin-top:8px;" title="@Localizer["InfoTexte"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="help" /><span></span></div></NavLink>
                <h2 style="display:inline-block;">@Localizer["Bundesliga"].Value @Localizer["Statistiken"].Value</h2>
            </div>
        </div>
    </RadzenCard>

    <RadzenTabs Style="margin-top:25px;" @bind-SelectedIndex=@selectedIndex Change=@OnChange>
        <Tabs>
            <RadzenTabsItem Text="@Localizer["Verein gegen Verein"].Value">
                <RadzenCard Style="height:70vh;" class="m-0">
                    <div class="content">
                        <div class="form-group row">
                            <div class="col-sm-6">
                                <label style="display:inline-block;" class="col-sm-2 pl-0">Verein</label>
                                <select id="cboSaison" style="display:inline-block;" class="form-control dropdown col-sm-12" @onchange="Verein1Change">
                                    <option value="" selected required>@Localizer["Verein wählen"].Value</option>
                                    @foreach (var verein in VereineList.Where(x => x.Bundesliga = true).OrderBy(x => x.Vereinname1))
                                    {
                                        <option value="@verein.VereinID"> @verein.Vereinname1 </option>
                                    }

                                </select>
                            </div>
                            <div class="col-sm-6">
                                <label style="display:inline-block;" class="col-sm-2 pl-0">Verein</label>
                                <select id="cboSaison" style="display:inline-block;" class="form-control dropdown col-sm-12" @onchange="Verein2Change">
                                    <option value="" selected required>@Localizer["Verein wählen"].Value</option>
                                    @foreach (var verein in VereineList.Where(x => x.Bundesliga = true).OrderBy(x => x.Vereinname1))
                                    {
                                        <option value="@verein.VereinID"> @verein.Vereinname1 </option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-sm-12">
                                <label style="display:@DisplayElements;">@Localizer["Spielpaarungen"].Value : @Spielergebnisse.Count() </label>
                                <label style="display:@DisplayElements;">@Localizer["Statistiken"].Value : @Statistik</label>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-sm-12">

                                @if (IsLoading == true || Spielergebnisse == null)
                                {
                                    <RadzenStack AlignItems="AlignItems.Center" Class="rz-m-12" Gap="2rem">
                                        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                                    </RadzenStack>
                                }
                                else
                                {
                                    var SpieltageVV = Spielergebnisse.OrderByDescending(x => x.Datum);

                                    foreach (var spieltag in SpieltageVV)
                                    {
                                        spieltag.Doppelpunkt = ":";
                                    }

                                    <RadzenDataGrid @ref="grid" Data="@SpieltageVV" EmptyText="@Localizer["Keine Ergebnisse zum Anzeigen"].Value" class="table table-striped" FilterMode="FilterMode.Advanced" PageSize="12"
                                                    AllowPaging="true" AllowSorting="true" AllowFiltering="false"
                                                    TItem="Spieltag" Visible="true" Responsive=true AllowColumnResize="true"
                                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                    SelectionMode="DataGridSelectionMode.Single" LogicalFilterOperator="LogicalFilterOperator.Or">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="Spieltag" Property="SpieltagId" Width="50px" TextAlign="TextAlign.Right" Filterable="false" Visible=false Sortable=false Title="SpieltagId" />
                                            <RadzenDataGridColumn TItem="Spieltag" CssClass="VereinMinWidth" Property="Verein1" Width="30%" Sortable=true Title="@Localizer["Heim"].Value">

                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="Spieltag" Title="" Sortable="true" Width="44px" MinWidth="44px">
                                                <Template Context="data">
                                                    <RadzenImage Path="@($"/Images/{data.Verein1}.webp")" style="width: 30px; height: 30px;" title="@data.Verein1" AlternateText="@(data.Verein1)" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="Spieltag" CssClass="FarbeTorePunkt" Property="Tore1_Nr" TextAlign="TextAlign.Right" Width="22px" Sortable=true />
                                            <RadzenDataGridColumn TItem="Spieltag" CssClass="FarbeTorePunkt" Property="Doppelpunkt" TextAlign="TextAlign.Center" Width="10px" Sortable=false />
                                            <RadzenDataGridColumn TItem="Spieltag" CssClass="FarbeTorePunkt" Property="Tore2_Nr" TextAlign="TextAlign.Left" Width="22px" Sortable=true />

                                            <RadzenDataGridColumn TItem="Spieltag" Title="" Sortable="true" Width="44px" MinWidth="44px">
                                                <Template Context="data">
                                                    <RadzenImage Path="@($"/Images/{data.Verein2}.webp")" style="width: 30px; height: 30px;" title="@data.Verein2" AlternateText="@(data.Verein2)" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="Spieltag" CssClass="VereinMinWidth" Property="Verein2" Width="25%" Sortable=true Title="@Localizer["Auswärts"].Value" />
                                            <RadzenDataGridColumn TItem="Spieltag" FormatString="{0:dd.MM.yyyy}" Property="Datum" Width="18%" Sortable=true Title=@Localizer["Datum"].Value />
                                            <RadzenDataGridColumn TItem="Spieltag" Property="Ort" Width="30%" Sortable=true Title=@Localizer["Ort"].Value />


                                        </Columns>

                                    </RadzenDataGrid>


                                }
                            </div>
                        </div>
                    </div>
                </RadzenCard>
            </RadzenTabsItem>
            <RadzenTabsItem Text="@Localizer["Höchste Heimsiege"].Value">
                <RadzenCard Style="height:85vh;" class="m-0">
