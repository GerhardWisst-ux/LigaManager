@page "/Ligamanager"
@namespace LigaManagement.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ligamanager</title>
    <base href="~/Ligamanager" />    
    <link href="~/css/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <script src="~/jquery/jquery.min.js"></script>
    <link href="~/css/jquery-ui.css" rel="stylesheet" />    
    <script src="~/jquery/bootstrap.min.js"></script>
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/default.css" rel="stylesheet" />
    <link href="~/css/standard-base.css" rel="stylesheet" />
    <link href="~/css/leaflet.css" rel="stylesheet" />
    <link href="~/css/font-awesome.min.css" rel="stylesheet" />
    <script src="~/js/chart.js"></script>
    <script src="~/js/leaflet.js"></script>
    
</head>
<body>
    <app>
        <component type="typeof(App)" render-mode="Server" />
    </app>

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
            <a href="" class="reload">Reload</a>
            <a class="dismiss">🗙</a>
        </environment>
        <environment includ="Development">
            Ein unbehandelter Fehler ist aufgetreten. Bitte Browser Tools aufrufen um Details zu erfahren
            <a href="" class="Neu laden">Reload</a>
            <a class="dismiss">🗙</a>
        </environment>        
    </div>
    @* Signal-R Connection *@
    <script src="_framework/blazor.server.js"></script>    
</body>
</html>
