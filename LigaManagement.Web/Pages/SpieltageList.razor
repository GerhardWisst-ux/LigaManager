@page "/Ligamanager/{CurrentligaUrl}/spieltage/{SpieltagNr}"
@page "/Ligamanager/spieltage/"
@inherits LigaManagerManagement.Web.Pages.SpieltagListBase
@inject LigaManagerManagement.Web.Services.LigaManagerAuthenticationStateProvider _LigaManagerAuthenticationStateProvider
@inject DialogService DialogService
@inject NavigationManager _navigationManager

@attribute [Authorize]

<head>

</head>
<style type="text/css">


    .NewBtn {
        gap: 1px;
        margin-right: 2px;
        align-self: end;
        justify-content: end;
        margin-right: 0px !important;
    }

    #btnVor, #btnZurueck {
        text-decoration: none;
        display: inline-block;
        padding: 8px 16px;
    }

    a:hover {
        background-color: #ddd;
        color: black;
    }

    .previous, .next {
        background-color: #1b6ec2;
        border-color: #1861ac;
        color: white !important;
    }

    .round {
        border-radius: 50%;
    }

    .VereinMinWidth {
        min-width: 80px;
        font-weight: normal;
    }

    .Doublepoint {
        font-weight: bold !important;
        background: black;
        background-color: black !important;
        color: white !important;
    }

    .rz-data-grid-data {
        border-collapse: revert !important;
    }

    .rz-datatable td {
        padding: 3.5px !important;
    }

    .FarbeTorePunkt {
        color: white !important;
        width: auto !important;
        border-top-color: black !important;
        border-bottom-color: black !important;
        border-left-color: black !important;
        border-right-color: black !important;
        background-color: black !important;
        --rz-grid-cell-color: white;
    }

    .FarbeTorePunktH {
        color: white !important;
        vertical-align: bottom;
        width: auto !important;
        border-top-color: black !important;
        border-bottom-color: black !important;
        border-left-color: black !important;
        border-right-color: black !important;
        background-color: black !important;
        --rz-grid-cell-color: white;
    }
</style>

@if (IsLoading)
{
    <RadzenStack AlignItems="AlignItems.Center" Class="rz-m-12" Gap="2rem">
        <RadzenProgressBarCircular Value="100" ShowValue="true" Mode="ProgressBarMode.Determinate" />
    </RadzenStack>
}
else
{
    <div class="container-fluid">
        <div class="form-group row">
            <div class="col-sm-12">
                <RadzenCard class="m-0 rz-shadow-3" style="min-height:120px;">
                    <div class="d-flex flex-row">
                        <div class="card-body">
                            <span style="color:#1151f3; background-color:transparent;" class="float-right">@Localizer["Eingeloggter Benutzer"].Value: @_LigaManagerAuthenticationStateProvider.CurrentUser.Username</span>
                            <br />
                            <NavLink href="@($"Ligamanager/account/logout")" style="margin-top:8px;" title="@Localizer["Ausloggen"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="logout" /><span></span></div></NavLink>
                            <NavLink href="@($"Ligamanager/einstellungen")" style="margin-top:8px;" title="@Localizer["Einstellungen"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="settings" /><span></span></div></NavLink>
                            <NavLink href="@($"Ligamanager/info")" style="margin-top:8px;" title="@Localizer["Info"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="info" /><span></span></div></NavLink>
                            <NavLink href="@($"InfoTexteList")" style="margin-top:8px;" title="@Localizer["InfoTexte"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="help" /><span></span></div></NavLink>
                            <h2>@Globals.currentLand @Liganame @SpieltagNr.ToString().@Localizer["Spieltag"].Value</h2>

                        </div>
                    </div>
                </RadzenCard>
            </div>
        </div>
        <RadzenCard style="margin-bottom:4px;min-height:80px;">
            <div class="form-group row">
                <div class="dropdown mr-2" style="display:inline; margin-left:4px;">
                    <select id="cboSpieltage" data-toggle="tooltip" title=@Localizer["Spieltag"].Value style="height:38px; width:180px; display:inline-block;" class="form-control" @onchange="SpieltagChange">
                        <option value="0" selected="selected">@Localizer["Spieltag wählen"].Value</option>
                        if (@SpieltagList != null)
                        {
                        @foreach (var spieltag in SpieltagList)
                        {
                            @if (spieltag.Nummer == @SpieltagNr)
                            {
                                <option selected value="@spieltag.Nummer"> @spieltag.Name</option>
                            }
                            else
                            {
                                <option value="@spieltag.Nummer"> @spieltag.Name</option>
                            }
                        }
                        }
                    </select>
                    
                    <div class="btn-group" role="group">
                        <span class="ml-3">
                            @if (VisibleBtnNew)
                            {
                                <RadzenButton Click=@(args => OnClick("Primary icon button")) Icon="add_circle_outline" Style="display:inline-block;" title="@Localizer["Neuanlage"].Value" ButtonStyle="ButtonStyle.Primary" />

                            }
                            else
                            {
                                <RadzenButton Click=@(args => OnClick("Primary icon button")) Icon="add_circle_outline" tyle="display:none;" title="@Localizer["Neuanlage"].Value" ButtonStyle="ButtonStyle.Primary" />

                            }
                        </span>
                        <div Style="display:inline-block;" class="row">
                            <div Style="display:inline-block;" class="col-md-1">
                                <RadzenButton title="@Localizer["Erzeugen Spieltag aus Spielplan"].Value" Visible="@VisibleSpielplan" Click=@(args => ErzeugenSpieltag()) Style="margin-left: 3px;display:inline-block;" Text="@Localizer["Erzeugen"].Value" ButtonStyle="ButtonStyle.Primary">
                                    <i class="oi oi-data-transfer-download"></i>
                                </RadzenButton>
                            </div>
                        </div>
                        <div Style="display:inline-block;" class="row">
                            <div Style="display:inline-block;" class="col-md-1">
                                <RadzenButton title="@Localizer["Tabelle"].Value" Click=@(args => AnzeigenTabelle()) Style="margin-left: 3px;display:inline-block;" Text="@Localizer["Tabelle"].Value" ButtonStyle="ButtonStyle.Primary">
                                    <span class="oi oi-list" aria-hidden="true"></span> 
                                </RadzenButton>
                            </div>
                        </div>

                        @if (Globals.currentLiganame == "Bundesliga")
                        {
                            <div Style="display:inline-block;" class="row">
                                <div Style="display:inline-block;" class="col-md-1">
                                    <RadzenButton title="@Localizer["Kader"].Value" Click=@(args => AnzeigenKader()) Style="margin-left: 3px;display:inline-block;" Text="@Localizer["Tabelle"].Value" ButtonStyle="ButtonStyle.Primary">
                                        <span class="oi oi-person" aria-hidden="true"></span>
                                    </RadzenButton>
                                </div>
                            </div>

                            <div Style="display:inline-block;" class="row">
                                <div Style="display:inline-block;" class="col-md-1">
                                    <RadzenButton title="@Localizer["Chart"].Value" Click=@(args => AnzeigenChart()) Style="margin-left: 3px;display:inline-block;" Text="@Localizer["Chart"].Value" ButtonStyle="ButtonStyle.Primary">
                                        <span class="oi oi-aperture" aria-hidden="true"></span>
                                    </RadzenButton>
                                </div>
                            </div>
                            <div Style="display:inline-block;" class="row">
                                <div Style="display:inline-block;" class="col-md-1">
                                    <RadzenButton title="@Localizer["Statistiken"].Value" Click=@(args => AnzeigenStatistiken()) Style="margin-left: 3px;display:inline-block;" Text="@Localizer["Statistiken"].Value" ButtonStyle="ButtonStyle.Primary">
                                        <span class="oi oi-bar-chart" aria-hidden="true"></span>
                                    </RadzenButton>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </RadzenCard>
        <div class="form-group row">
            <div class="col-sm-12">
                <RadzenCard style="flex:1;margin-right:0px; height:auto;">

                    <RadzenDataGrid @ref="grid" Data="@Spieltage" EmptyText="@Localizer["Keine Ergebnisse zum Anzeigen"].Value" class="table table-striped" FilterMode="FilterMode.Advanced" PageSize="12"
                                    AllowPaging="true" AllowSorting="true" AllowFiltering="false"
                                    TItem="Spieltag" Visible="true" Responsive=true AllowColumnResize="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    SelectionMode="DataGridSelectionMode.Single" Density="@Density" LogicalFilterOperator="LogicalFilterOperator.Or">
                        <Columns>
                            <RadzenDataGridColumn TItem="Spieltag" Property="SpieltagId" Width="50px" TextAlign="TextAlign.Right" Filterable="false" Visible=false Sortable=false Title="SpieltagId" />
                            <RadzenDataGridColumn TItem="Spieltag" CssClass="VereinMinWidth" Property="Verein1Anzeige" Width="30%" Sortable=true Title="@Localizer["Heim"].Value">

                            </RadzenDataGridColumn>
                            @if (Globals.LigaNummer == 20 || Globals.LigaNummer == 21)
                            {
                                <RadzenDataGridColumn TItem="Spieltag" Title="" Sortable="true" Width="44px" MinWidth="44px">
                                    <Template Context="data">
                                        <RadzenImage Path="@($"/Images/NoImage.webp")" style="width: 30px; height: 30px;" title="@data.Verein1" AlternateText="@(data.Verein1)" />
                                    </Template>
                                </RadzenDataGridColumn>
                            }
                            else
                            {
                                <RadzenDataGridColumn TItem="Spieltag" Title="" Sortable="true" Width="44px" MinWidth="44px">
                                    <Template Context="data">
                                        <RadzenImage Path="@($"/Images/{data.Verein1}.webp")" style="width: 30px; height: 30px;" title="@data.Verein1" AlternateText="@(data.Verein1)" />
                                    </Template>
                                </RadzenDataGridColumn>
                            }

                            <RadzenDataGridColumn TItem="Spieltag" CssClass="FarbeTorePunkt" Property="Tore1_Nr" TextAlign="TextAlign.Right" Width="22px" Sortable=true />
                            <RadzenDataGridColumn TItem="Spieltag" CssClass="FarbeTorePunkt" Property="Doppelpunkt" TextAlign="TextAlign.Center" Width="10px" Sortable=false />
                            <RadzenDataGridColumn TItem="Spieltag" CssClass="FarbeTorePunkt" Property="Tore2_Nr" TextAlign="TextAlign.Left" Width="22px" Sortable=true />


                            @if (Globals.LigaNummer == 20 || Globals.LigaNummer == 21)
                            {
                                <RadzenDataGridColumn TItem="Spieltag" Title="" Sortable="true" Width="44px" MinWidth="44px">
                                    <Template Context="data">
                                        <RadzenImage Path="@($"/Images/NoImage.webp")" style="width: 30px; height: 30px;" title="@data.Verein2" AlternateText="@(data.Verein2)" />
                                    </Template>
                                </RadzenDataGridColumn>
                            }
                            else
                            {
                                <RadzenDataGridColumn TItem="Spieltag" Title="" Sortable="true" Width="44px" MinWidth="44px">
                                    <Template Context="data">
                                        <RadzenImage Path="@($"/Images/{data.Verein2}.webp")" style="width: 30px; height: 30px;" title="@data.Verein2" AlternateText="@(data.Verein2)" />
                                    </Template>
                                </RadzenDataGridColumn>
                            }

                            <RadzenDataGridColumn TItem="Spieltag" CssClass="VereinMinWidth" Property="Verein2Anzeige" Width="25%" Sortable=true Title="@Localizer["Auswärts"].Value" />

                            <RadzenDataGridColumn TItem="Spieltag" FormatString="{0:dd.MM.yyyy}" Property="Datum" Width="18%" Sortable=true Title=@Localizer["Datum"].Value />
                            <RadzenDataGridColumn TItem="Spieltag" Property="Ort" Width="30%" Sortable=true Title=@Localizer["Ort"].Value />

                            <RadzenDataGridColumn TextAlign="TextAlign.Right" TItem="Spieltag" Property="SpieltagId" Width="80px" Filterable="false" Sortable="false">
                                <Template Context="data">
                                    <NavLink href="@($"Ligamanager/editspieltag/{data.SpieltagId}")" title="@Localizer["Bearbeiten"].Value" class="btn btn-primary btn-sm"><div><RadzenIcon Icon="edit" title="@Localizer["Bearbeiten"].Value" /></div></NavLink>
                                </Template>
                            </RadzenDataGridColumn>
                            <hr style="border:5px;" />
                        </Columns>
                        <FooterTemplate>
                        </FooterTemplate>
                        <FooterTemplate>
                            @Localizer["Spiele"]: <b>@Spieltage.Count()</b>
                            @Localizer["Tore"]: <b>@Spieltage.Sum(x => x.Tore1_Nr + x.Tore2_Nr)</b>
                            @Localizer["Tore Durchschnitt"]: <b>@string.Format("{0:0.00}", @Spieltage.Average(x => x.Tore1_Nr + x.Tore2_Nr))</b>
                        </FooterTemplate>
                    </RadzenDataGrid>

                    <div class="row">
                        <div class="col-md-1">
                            <a type="button" id="btnZurueck" Style="text-align:left;display:inline-block;" data-toggle=@Localizer["Voriger Spieltag"] title="@Localizer["Voriger Spieltag"]" @onclick="SpieltagZurueck" class="previous round">&laquo;</a>
                        </div>
                        <div class="col-md-11 text-right">
                            <a type="button" id="btnVor" data-toggle="@Localizer["Nächster Spieltag"]" title="@Localizer["Nächster Spieltag"]" @onclick="SpieltagVor" style="width: auto; text-align:left;display:inline-block;" class="next round">&raquo;</a>
                        </div>
                    </div>
                </RadzenCard>
                @* </div> *@
            </div>
        </div>
    </div>

    @code {



    async Task OpenSpieltag(int? spieltagsid)
    {
        await DialogService.OpenAsync<DialogCardPage>($"Spieltag {spieltagsid}",
              new Dictionary<string, object>() { { "SpieltagsID", spieltagsid } },
              new DialogOptions() { Width = "700px", Height = "520px" });
    }

    private void OnClick(string text)
    {
        _navigationManager.NavigateTo("Ligamanager/createspieltag/" + SpieltagNr);

    }

    private void AnzeigenTabelle()
    {
        _navigationManager.NavigateTo($"Ligamanager/{Globals.currentLigaUrl}/tabellen");
    }
    private void AnzeigenKader()
    {
        Globals.KaderVereinNr = 0;
        _navigationManager.NavigateTo($"Ligamanager/kader");
    }

    private void AnzeigenChart()
    {
        _navigationManager.NavigateTo($"Ligamanager/chartPunkte");
    }

    private void AnzeigenStatistiken()
    {
        _navigationManager.NavigateTo($"Ligamanager/statistiken");
    }



    private async void ErzeugenSpieltag()

    {
        var Spieltage = (await SpieltagService.GetSpieltage()).ToList();
        Spieltage = Spieltage.Where(st => st.SpieltagNr == SpieltagNr.ToString() && st.SaisonID == Globals.SaisonID).ToList();

        if (Spieltage.Count() > 0)
        {
            await DialogService.OpenAsync<DialogCardPage>(string.Empty,
             new Dictionary<string, object>() { { "SpieltagNr", Spieltage[0].SpieltagNr.ToString() } },
             new DialogOptions() { Width = "700px", Height = "512px", Resizable = true, Draggable = false });


        }

        var Spielplaene = (await SpielplanService.GetSpielplaene()).ToList();

        Spielplaene = Spielplaene.Where(st => st.SpieltagNr == SpieltagNr.ToString() && st.SaisonID == Globals.SaisonID).ToList();



        if (Spielplaene != null)
        {

            for (int i = 0; i < Spielplaene.Count(); i++)

            {

                Spieltag spieltag = new Spieltag();



                spieltag.SpieltagId = 0;

                spieltag.Saison = Spielplaene[i].Saison;

                spieltag.SaisonID = Spielplaene[i].SaisonID;

                spieltag.LigaID = Spielplaene[i].LigaID;

                spieltag.Doppelpunkt = ":";

                spieltag.SpieltagNr = Spielplaene[i].SpieltagNr;

                spieltag.Verein1 = Spielplaene[i].Verein1;

                spieltag.Verein1Anzeige = Spielplaene[i].Verein1Anzeige;

                spieltag.Verein2Anzeige = Spielplaene[i].Verein2Anzeige;

                spieltag.Verein1_Nr = Spielplaene[i].Verein1_Nr;

                spieltag.Verein2 = Spielplaene[i].Verein2;

                spieltag.Verein2_Nr = Spielplaene[i].Verein2_Nr;

                spieltag.Tore1_Nr = Spielplaene[i].Tore1_Nr;

                spieltag.Tore2_Nr = Spielplaene[i].Tore2_Nr;

                spieltag.Schiedsrichter = Spielplaene[i].Schiedsrichter;

                spieltag.Datum = DateTime.Parse(Microsoft.VisualBasic.Strings.Right(Spielplaene[i].DatumString, 10)).AddDays(-1).AddMinutes(930);

                spieltag.Abgeschlossen = Spielplaene[i].Abgeschlossen;

                spieltag.Zuschauer = Spielplaene[i].Zuschauer;

                spieltag.TeamIconUrl1 = Spielplaene[i].TeamIconUrl1;

                spieltag.TeamIconUrl2 = Spielplaene[i].TeamIconUrl2;



                var stadien = await StadionService.GetStadien();

                var stadion = stadien.Where(x => x.VereinNr == Convert.ToInt32(Spielplaene[i].Verein1_Nr?.ToString()) && x.JahrVonDate < DateTime.Parse(Microsoft.VisualBasic.Strings.Right(Spielplaene[i].DatumString, 10)).AddDays(-1) && x.JahrBisDate > DateTime.Parse(Microsoft.VisualBasic.Strings.Right(Spielplaene[i].DatumString, 10)).AddDays(-1)).ToList();



                if (stadion.Count == 1)  // genau ein Stadion gefunden

                {

                    spieltag.StadionID = stadion[0].Id;

                    spieltag.Ort = stadion[0].Stadionname;

                }



                else

                {

                    spieltag.StadionID = 0;

                    spieltag.Ort = "Stadion nicht gefunden";

                }





                var Spieltag = await SpieltagService.CreateSpieltag(spieltag);

            }


        }

    }

    }

}
