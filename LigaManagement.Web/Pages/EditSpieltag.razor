                    if (spielplan.Count() == 0)

                    {

                        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = @Titel, Detail = "Spiel nicht im Spielplan. Speichern nicht möglich." });

                        return;

                    }

                }
                var stadien = await StadionService.GetStadien();
                var stadion = stadien.Where(x => x.VereinNr == Convert.ToInt32(Spiel.Verein1_Nr.ToString()) && x.JahrVonDate < Spiel.Datum && x.JahrBisDate > Spiel.Datum).ToList();
                if (stadion.Count() == 1)  // genau ein Stadion gefunden
                    Spiel.StadionID = stadion[0].Id;
                else
                    Spiel.StadionID = 0;

                spieltag = await _SpieltagService.UpdateSpieltag(Spiel);
            }
            else if (Globals.LigaID == 3)
            {
                // var spielplaene = await _SpielplanService.GetSpielplaene();
                // var spielplan = spielplaene.Where(x => x.SpieltagNr == SpieltagNr && x.Saison == Globals.currentSaison && x.LigaID == Globals.LigaID && x.Verein1_Nr == Spiel.Verein1_Nr && x.Verein2_Nr == Spiel.Verein2_Nr).ToList();

                // if (spielplan.Count() == 0)
