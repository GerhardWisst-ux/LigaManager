        DateTime SpielDateTime = Spiel.Datum.Date.AddMinutes(spieldatetime);
        Spiel.SpieltagNr = SpieltagNr;
        Spiel.Saison = Globals.currentSaison;
        Spiel.SaisonID = Globals.SaisonID;
        Spiel.LigaID = Convert.ToInt32(Globals.LigaID);

