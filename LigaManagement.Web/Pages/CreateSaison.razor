                        <RadzenColumn Size="8" Offset="4" class="rz-white rz-p-0">
                        </RadzenColumn>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.SpielplanVorhanden" />
                        </div>
                    </div>

                    <div class="form-group row mt-5">
                        <RadzenLabel Text="@Localizer["Vereine"].Value" class="col-md-3 col-xs-12">@Localizer["Vereine"].Value</RadzenLabel>
                    </div>

                    <div class="form-group">
                        <ul id="listVereine" class="ul">
                            @foreach (var verein in vereinesaisonSelected.OrderBy(x => x.Vereinsname1))
                            {
                                string Id = @verein.VereinNr.ToString();
                                <li><input @onchange="eventArgs => { CheckboxClicked(Id, eventArgs.Value); }" name="checkvereindisabled" checked="checked" data-bind=" @verein.VereinNr" class="col-sm-2" type="checkbox"><span>@verein.Vereinsname1</span></li>
                            }
