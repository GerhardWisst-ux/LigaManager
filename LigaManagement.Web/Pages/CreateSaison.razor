                        <RadzenTextBox required name="txtSaisonname" id="txtSaisonname" @bind-Value="Saison.Saisonname" class="form-control col-md-9 col-xs-12"></RadzenTextBox>

                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.Saisonname" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">

                        <RadzenLabel Text="Liganame" class="col-md-3 col-xs-12 " Component="txtLiganame">@Localizer["Liganame"].Value</RadzenLabel>
                        <select value="@LigaID" id="cboLiga" class="form-control col-md-9 col-xs-12 dropdown" @onchange="LigaChange">
                            <option value="0" required>@Localizer["Liga wählen"].Value</option>
                            @if (LigenList != null)
                            {
                                @foreach (var liga in LigenList.Where(x => x.Aktiv == true).OrderBy(o => o.LigaID))
                                {
                                    <option value="@liga.LigaID" selected="@(liga.LigaID == Globals.LigaID)">@liga.Liganame</option>
                                }
                            }
                        </select>
                        <label for="cboLiga" class="col-md-9 col-xs-12 offset-md-3" style="color:red;@DisplayErrorLiga">@Localizer["Bitte Liga wählen"].Value</label>

                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="AnzahlVereine" class="col-md-3 col-xs-12" Component="txtVereinsname2">@Localizer["Anzahl Vereine"].Value</RadzenLabel>
                        <InputNumber required id="txtAnzahlVereine" @bind-Value="Saison.AnzahlVereine" class="form-control col-md-9 col-xs-12 elementleft"></InputNumber>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.AnzahlVereine" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="@Localizer["AnzahlCL_Plaetze"].Value" class="col-md-3 col-xs-12" Component="txtAnzahlCL_Plaetze">@Localizer["AnzahlCL_Plaetze"].Value</RadzenLabel>
                        <InputNumber required id="txtAnzahlCL_Plaetze" @bind-Value="Saison.CL_League" class="form-control col-md-9 col-xs-12"></InputNumber>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.CL_League" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="@Localizer["AnzahlEL_Plaetze"].Value" class="col-md-3 col-xs-12" Component="txtAnzahlCL_Plaetze">@Localizer["AnzahlEL_Plaetze"].Value</RadzenLabel>
                        <InputNumber required id="txtAnzahlEL_Plaetze" @bind-Value="Saison.EL_League" class="form-control col-md-9 col-xs-12"></InputNumber>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.EL_League" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="@Localizer["AnzahlCF_Plaetze"].Value" class="col-md-3 col-xs-12" Component="txtAnzahlCL_Plaetze">@Localizer["AnzahlCF_Plaetze"].Value</RadzenLabel>
                        <InputNumber required id="txtAnzahlEL_Plaetze" @bind-Value="Saison.CF_League" class="form-control col-sm-9"></InputNumber>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.CF_League" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="@Localizer["Aufsteiger"].Value" class="col-md-3 col-xs-12" Component="txtAufsteiger">@Localizer["Aufsteiger"].Value</RadzenLabel>
                        <InputNumber id="txtAufsteiger" @bind-Value="Saison.Aufsteiger" class="form-control col-md-9 col-xs-12"></InputNumber>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.Aufsteiger" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="@Localizer["Absteiger"].Value" class="col-md-3 col-xs-12" Component="txtAbsteiger">@Localizer["Absteiger"].Value</RadzenLabel>
                        <InputNumber id="txtAbsteiger" @bind-Value="Saison.Absteiger" class="form-control col-md-9 col-xs-12"></InputNumber>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.Absteiger" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="@Localizer["Relegation"].Value" class="col-md-3 col-xs-12" Component="txtRelegation">@Localizer["Relegation"].Value</RadzenLabel>
                        <InputNumber id="txtRelegation" @bind-Value="Saison.Relegation" class="form-control col-md-9 col-xs-12"></InputNumber>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.Relegation" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="lblAktiv" class="col-md-3 col-xs-12" Component="chkAktiv">@Localizer["Aktiv"].Value</RadzenLabel>
                        <RadzenCheckBox @bind-Value="Saison.Aktuell" Style="border-width:0px; width:40px;max-width:40px;margin-left:0px;" class="form-control  col-md-9 col-xs-12" Name="chkAktiv" />
                        <RadzenColumn Size="8" Offset="4" class="rz-white rz-p-0">
                        </RadzenColumn>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.Aktuell" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="lblAbgeschlossen" class="col-md-3 col-xs-12" Component="chkAbgeschlossen">@Localizer["Abgeschlossen"].Value</RadzenLabel>
                        <RadzenCheckBox @bind-Value="Saison.Abgeschlossen" Style="border-width:0px; width:40px;max-width:40px;margin-left:0px;" class="form-control  col-md-9 col-xs-12" Name="chkAbgeschlossen" />
                        <RadzenColumn Size="8" Offset="4" class="rz-white rz-p-0">
                        </RadzenColumn>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.Abgeschlossen" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="@Localizer["Spielplan vorhanden"].Value" class="col-md-3 col-xs-12" Component="chkSpielplanVorhanden">@Localizer["Spielplan vorhanden"].Value</RadzenLabel>
                        <RadzenCheckBox @bind-Value="Saison.SpielplanVorhanden" Style="border-width:0px; width:40px;max-width:40px;margin-left:0px;" class="form-control  col-md-9 col-xs-12" Name="chkSpielplanVorhanden" />
                        <RadzenColumn Size="8" Offset="4" class="rz-white rz-p-0">
                        </RadzenColumn>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.SpielplanVorhanden" />
                        </div>
                        <RadzenLabel Text="@Localizer["Ausgewählte Vereine"].Value" class="col-md-3 col-xs-12">@Localizer["Ausgewählte Vereine"].Value (@SelectedVereine.Count/@Saison.AnzahlVereine)</RadzenLabel>

                        <div class="list-container">
                            <div class="list">
                                @foreach (var verein in SelectedVereine.OrderBy(v => v.Vereinname1))
                                {
                                    <div class="list-item" @onclick="() => ToggleSelection(verein)">
                                        @verein.Vereinname1
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenButton title="@Localizer["Speichert Saison ab"].Value" id="btnSpeichern" Click="SaveSaison" class="btn btn-primary ml-3" Text="@Localizer["Speichern"].Value">
                            @Localizer["Speichern"].Value
                        </RadzenButton>
                    </div>
                </RadzenStepsItem>
            </Steps>
        </RadzenSteps>
    </EditForm>
}
@code {

    public string Titel { get; set; }
    private string saison;
    private string savedSaison;

    private string liganame;
    private string savedliganame;

    // private string aboutMe;
    //private string savedAboutMe;


    private void OnChange()
    {
        saison = savedSaison;
        liganame = savedliganame;

    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

            //Neuanlage
            SaisonId = "";
            Titel = @Localizer["Neuanlage Saison"].Value;
            await LoadSaison();
            IsLoading = false;

        }
    }

    @code {
        private async Task LoadSaison()
        {
            IsLoading = true;
            int parsedSaisonId;
            if (int.TryParse(SaisonId, out parsedSaisonId))
            {
                Saison = await _SaisonenService.GetSaison(parsedSaisonId);
            }
            else
            {
                Saison = new LigaManagerManagement.Models.Saison();
            }

            Saison.SaisonID = 0;
            Saison.LigaID = 1;
            Saison.Saisonname = "";
            Saison.Liganame = "";
            Saison.AnzahlVereine = 0;
            Saison.CL_League = 0;
            Saison.EL_League = 0;
            Saison.CF_League = 0;
            Saison.Relegation = 0;
            Saison.LandID = 0;
            Saison.Aktuell = true;
            Saison.Abgeschlossen = false;
            Saison.SpielplanVorhanden = false;
            IsLoading = false;
            StateHasChanged();
        }
    }







    private void CanChange(StepsCanChangeEventArgs args)
    {
        if (string.IsNullOrEmpty(Saison.Saisonname))
        {
            _NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = Titel,
                Detail = "Sie haben keinen gültigen Saisonnamen angegeben. Fortfahren nicht möglich."
            });
            args.SelectedIndex = 0; // Schrittwechsel abbrechen
            args.PreventDefault();
            return;
        }

        if (string.IsNullOrEmpty(Liganame))
        {
            _NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = Titel,
                Detail = "Sie haben keinen gültigen Liganamen angegeben. Fortfahren nicht möglich."
            });
            args.SelectedIndex = 0; // Schrittwechsel abbrechen
            args.PreventDefault();
            return;
        }

        if (Saison.AnzahlVereine < 8)
        {
            _NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = Titel,
                Detail = "Anzahl der Vereine für eine Saison muß mindestens 8 sein."
            });
            args.SelectedIndex = 0; // Schrittwechsel abbrechen
            args.PreventDefault();
            return;
        }

        if (Saison.Absteiger == 0)
        {
            _NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = Titel,
                Detail = "Anzahl der Absteiger darf nicht 0 sein."
            });
            args.SelectedIndex = 0; // Schrittwechsel abbrechen
            args.PreventDefault();
            return;
        }

        if (!Saison.Abgeschlossen && !Saison.Aktuell)
        {
            _NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = Titel,
                Detail = "Entweder Abgeschlossen oder Aktuell muß angegeben werden. Fortfahren nicht möglich."
            });
            args.SelectedIndex = 0; // Schrittwechsel abbrechen
            args.PreventDefault();
            return;
        }

        if (Saison.Abgeschlossen && Saison.Aktuell)
        {
            _NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = Titel,
                Detail = "Entweder Abgeschlossen oder Aktuell muß angegeben werden. Fortfahren nicht möglich."
            });
            args.SelectedIndex = 0; // Schrittwechsel abbrechen
            args.PreventDefault();
            return;
        }

        if (args.SelectedIndex == 1)
        {
            if (SelectedVereine.Count() != Saison.AnzahlVereine)
            {
                _NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = Titel,
                    Detail = $"Es sind keine {Saison.AnzahlVereine} Vereine angegeben. Speichern nicht möglich."
                });
                args.SelectedIndex = 0; // Schrittwechsel abbrechen
                args.PreventDefault();
                return;
            }
        }
    }


    private void SaveGrunddaten()
    {

        if ((Saison.Saisonname == "" || Saison.Saisonname == null))
        {
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = Titel, Detail = "Sie haben keinen gültigen Saisonnamen angegeben.Fortfahren nicht möglich." });
        }

        if ((Saison.Liganame == "" || Saison.Liganame == null))
        {
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = Titel, Detail = "Sie haben keinen gültigen Liganamen angegeben.Fortfahren nicht möglich." });
        }

        else if ((Saison.AnzahlVereine < 10 && Saison.AnzahlVereine > 30))
        {
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = Titel, Detail = "AnzahlVereine muß zwischen 10 und 30 liegen.Fortfahren nicht möglich." });
        }

        else if ((Saison.Abgeschlossen == false && Saison.Aktuell == false))
        {
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = Titel, Detail = "Entweder Abgeschlossen oder Aktuell muß angegeben werden.Fortfahren nicht möglich." });
        }

        savedSaison = saison;
        savedliganame = liganame;
    }

    private async void SaveSaison()
    {
        if ((SelectedVereine.Count() != Saison.AnzahlVereine))
        {
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = Titel, Detail = "Es sind keine " + Saison.AnzahlVereine + " Vereine angegeben. Speichern nicht möglich." });
            return;
        }

        LigaManagerManagement.Models.Saison SaisonenServiceCreated;

        var liga = await LigaService.GetLiga(LigaID);

        Saison.LandID = LandID;

        if (SaisonId == "" || SaisonId is null)
        {
            Saison.SaisonID = 0;
            Saison.LigaID = LigaID;
            Saison.Ligahoehe = LigaID;
            Saison.Liganame = Liganame;
        }
        else
        {
            Saison.SaisonID = Convert.ToInt32(SaisonId);
            Saison.Ligahoehe = Saison.LigaID;
        }

        // ToDo Transaction
        SaisonenServiceCreated = await SaisonenService.CreateSaison(Saison);

        var Saisonen = await SaisonenService.GetSaisonen();
        SaisonenServiceCreated.SaisonID = Saisonen.OrderBy(x => x.SaisonID).Last().SaisonID;

        List<VereineSaison> lstVereineSaison = new List<VereineSaison>();
        SaisonenServiceCreated.SaisonID = 500;

        if (SaisonenServiceCreated.SaisonID > 0)
        {
            for (int i = 0; i <= SelectedVereine.Count - 1; i++)
            {
                VereineSaison item = new VereineSaison();

                item.Id = i + 1;
                item.VereinNr = Convert.ToInt32(SelectedVereine[i].VereinID);
                item.LandID = 75; // SaisonenServiceCreated.LandID;
                item.SaisonID = 500; // SaisonenServiceCreated.SaisonID;
                item.LigaID = Saison.LigaID;
                lstVereineSaison.Add(item);
            }



            List<VereineSaison> resultCreateVereineSaison = null;
            List<VereineSaison> resultCreateVereineAusSaison = null;

            if (LigaID < 4)
                resultCreateVereineSaison = await _VereineSaisonService.CreateVereineSaison(lstVereineSaison);
            else if (LigaID >= 4)
                resultCreateVereineAusSaison = await _VereineSaisonAusService.CreateVereineSaison(lstVereineSaison);



            if (resultCreateVereineSaison != null)

                _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = Titel, Detail = "Saison erfolgreich abgespeichert." });
            else
                _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = Titel, Detail = "Fehler beim Abspeichern der Saison." });

            //_navigationManager.NavigateTo("/Ligamanager/saisonen");
        }
        else
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Neuanlage Saison SaisonenServiceCreated.SaisonID ist null:", Detail = "Saison konnte nicht angelegt werden." });
    }

