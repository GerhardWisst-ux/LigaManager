    private void SaveVereine()
    {
        if ((vereinesaisonSelected.Count() != Saison.AnzahlVereine))
        {
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Neuanlage Saison", Detail = "Es sind " + vereinesaisonSelected.Count() + " statt " + Saison.AnzahlVereine + "  Vereine angegeben.Fortfahren nicht möglich." });
            return;
        }
    }

    private async void SaveSaison()
    {
        try
        {
            LigaManagerManagement.Models.Saison SaisonenServiceCreated;

            var liga = await LigaService.GetLiga(LigaID);
            var land = await LandService.GetLand(liga.LandID);

            Saison.LigaID = LigaID;
            Saison.Ligahoehe = LigaID;
            Saison.Liganame = Liganame;
            Saison.LandID = land.Id;

            SaisonenServiceCreated = await _SaisonenService.CreateSaison(Saison);

            List<VereineSaison> lstVereineSaison = new List<VereineSaison>();

            var Saisonen = await SaisonenService.GetSaisonen();
            SaisonenServiceCreated.SaisonID = Saisonen.OrderBy(x => x.SaisonID).Last().SaisonID;

            if (SaisonenServiceCreated.SaisonID > 0)
            {
                for (int i = 0; i <= vereinesaisonSelected.Count - 1; i++)
                {
                    VereineSaison item = new VereineSaison();

                    item.Id = i + 1;
                    item.VereinNr = vereinesaisonSelected[i].VereinNr;
                    item.LandID = SaisonenServiceCreated.LandID;
                    item.SaisonID = SaisonenServiceCreated.SaisonID;
                    item.LigaID = SaisonenServiceCreated.LigaID;
                    lstVereineSaison.Add(item);
                }

                var result = await _VereineSaisonService.CreateVereineSaison(lstVereineSaison);

                if (result != null)
                {
                    _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Neuanlage Saison", Detail = "Saison erfolgreich angelegt." });
                }
                else
                {
                    _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Neuanlage Saison", Detail = "Fehler beim Anlegen der Saison." });
                }

                //_navigationManager.NavigateTo("/Ligamanager/saisonen");
            }
            else
                _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Neuanlage Saison", Detail = "Saison konnte nicht angelegt werden." });

        }
        catch (Exception ex)
        {

            ErrorLogger.WriteToErrorLog(ex.Message, ex.StackTrace, Assembly.GetExecutingAssembly().FullName);
        }
    }
