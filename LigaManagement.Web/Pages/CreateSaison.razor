                                @if (LigenList != null)
                                {
                                    @foreach (var liga in LigenList.OrderBy(o => o.LigaID))
                                    {

                                        @if (liga.LigaID == LigaID)
                                        {
                                            <option selected value="@liga.LigaID"> @liga.Liganame</option>
                                        }
                                        else
                                        {
                                            <option value="@liga.LigaID"> @liga.Liganame</option>
                                        }
                                    }
                                }
                            </select>
