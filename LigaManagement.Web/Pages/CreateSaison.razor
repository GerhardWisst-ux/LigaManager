@page "/Ligamanager/createsaison/{SaisonId}"

@inherits LigaManagerManagement.Web.Pages.CreateSaisonListBase
@inject LigaManagement.Web.Services.Contracts.ISaisonenService _SaisonenService
@inject LigaManagement.Web.Services.Contracts.IVereineSaisonService _VereineSaisonService
@inject LigaManagement.Web.Services.Contracts.IVereineAusService _VereineSaisonAusService

@inject DialogService DialogService
@inject NavigationManager _navigationManager
@inject NotificationService _NotificationService
@inject LigaManagerManagement.Web.Services.LigaManagerAuthenticationStateProvider _LigaManagerAuthenticationStateProvider

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.0/css/bootstrap.min.css">
    <link href='https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/themes/ui-darkness/jquery-ui.css' rel='stylesheet'>

</head>


<style type="text/css">


    body {
        font-family: Arial, sans-serif;
        margin: 0px;
    }

    .containervereine {
        display: flex;
        gap: 20px;
    }

    .list-container {
        flex: 1;
    }

    .list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .list-item {
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        cursor: pointer;
        flex: 1 1 calc(33% - 10px); /* Vier Boxen pro Reihe */
        text-align: center;
        box-sizing: border-box;
    }

        .list-item.selected {
            background-color: #d4edda;
            border-color: #c3e6cb;
        }

    @@media (max-width: 768px) {
        .list-item {
            flex: 1 1 calc(50% - 10px); /* Zwei Boxen pro Reihe bei kleineren Bildschirmen */
        }
    }

    @@media (max-width: 480px) {
        .list-item {
            flex: 1 1 calc(100% - 10px); /* Eine Box pro Reihe bei sehr kleinen Bildschirmen */
        }
    }
</style>
@if (IsLoading)
{
    <RadzenStack AlignItems="AlignItems.Center" Class="rz-m-12" Gap="2rem">
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </RadzenStack>
}
else
{
    <EditForm Model="Saison" OnValidSubmit="SaveSaison">
        <RadzenSteps Change="@OnChange" CanChange="@CanChange">
            <Steps>
                <RadzenStepsItem PreviousText="@Localizer["Voriger Schritt"].Value" NextText="@Localizer["Nächster Schritt"].Value">
                    <h3>@Localizer["Grunddaten"].Value</h3>

                    <br />
                    <div class="form-group row m-0 row mb-1">

                        <RadzenLabel Text="Saisonname" class="col-md-3 col-xs-12" Component="txtSaisonname">@Localizer["Saisonname"].Value</RadzenLabel>
                        <RadzenTextBox required name="txtSaisonname" id="txtSaisonname" @bind-Value="Saison.Saisonname" class="form-control col-md-9 col-xs-12"></RadzenTextBox>

                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.Saisonname" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">

                        <RadzenLabel Text="Liganame" class="col-md-3 col-xs-12 " Component="txtLiganame">@Localizer["Liganame"].Value</RadzenLabel>
                        <select value="@LigaID" id="cboLiga" class="form-control col-md-9 col-xs-12 dropdown" @onchange="LigaChange">
                            <option value="0" required>@Localizer["Liga wählen"].Value</option>
                            @if (LigenList != null)
                            {
                                @foreach (var liga in LigenList.Where(x => x.Aktiv == true).OrderBy(o => o.LigaID))
                                {
                                    <option value="@liga.LigaID" selected="@(liga.LigaID == Globals.LigaID)">@liga.Liganame</option>
                                }
                            }
                        </select>
                        <label for="cboLiga" class="col-md-9 col-xs-12 offset-md-3" style="color:red;@DisplayErrorLiga">@Localizer["Bitte Liga wählen"].Value</label>

                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="AnzahlVereine" class="col-md-3 col-xs-12" Component="txtVereinsname2">@Localizer["Anzahl Vereine"].Value</RadzenLabel>
                        <InputNumber required id="txtAnzahlVereine" @bind-Value="Saison.AnzahlVereine" class="form-control col-md-9 col-xs-12 elementleft"></InputNumber>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.AnzahlVereine" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="@Localizer["AnzahlCL_Plaetze"].Value" class="col-md-3 col-xs-12" Component="txtAnzahlCL_Plaetze">@Localizer["AnzahlCL_Plaetze"].Value</RadzenLabel>
                        <InputNumber required id="txtAnzahlCL_Plaetze" @bind-Value="Saison.CL_League" class="form-control col-md-9 col-xs-12"></InputNumber>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.CL_League" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="@Localizer["AnzahlEL_Plaetze"].Value" class="col-md-3 col-xs-12" Component="txtAnzahlCL_Plaetze">@Localizer["AnzahlEL_Plaetze"].Value</RadzenLabel>
                        <InputNumber required id="txtAnzahlEL_Plaetze" @bind-Value="Saison.EL_League" class="form-control col-md-9 col-xs-12"></InputNumber>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.EL_League" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="@Localizer["AnzahlCF_Plaetze"].Value" class="col-md-3 col-xs-12" Component="txtAnzahlCL_Plaetze">@Localizer["AnzahlCF_Plaetze"].Value</RadzenLabel>
                        <InputNumber required id="txtAnzahlEL_Plaetze" @bind-Value="Saison.CF_League" class="form-control col-sm-9"></InputNumber>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.CF_League" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="@Localizer["Relegation"].Value" class="col-md-3 col-xs-12" Component="txtRelegation">@Localizer["Relegation"].Value</RadzenLabel>
                        <InputNumber id="txtRelegation" @bind-Value="Saison.Relegation" class="form-control col-md-9 col-xs-12"></InputNumber>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.Relegation" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="@Localizer["Aufsteiger"].Value" class="col-md-3 col-xs-12" Component="txtAufsteiger">@Localizer["Aufsteiger"].Value</RadzenLabel>
                        <InputNumber id="txtAufsteiger" @bind-Value="Saison.Aufsteiger" class="form-control col-md-9 col-xs-12"></InputNumber>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.Aufsteiger" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="@Localizer["Absteiger"].Value" class="col-md-3 col-xs-12" Component="txtAbsteiger">@Localizer["Absteiger"].Value</RadzenLabel>
                        <InputNumber id="txtAbsteiger" @bind-Value="Saison.Absteiger" class="form-control col-md-9 col-xs-12"></InputNumber>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.Absteiger" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="@Localizer["Aktiv"].Value" class="col-md-3 col-xs-12" Component="chkAktiv">@Localizer["Aktiv"].Value</RadzenLabel>
                        <RadzenCheckBox @bind-Value="Saison.Aktuell" Style="border-width:0px; width:40px;max-width:40px;margin-left:0px;" class="form-control  col-md-9 col-xs-12" Name="chkAktiv" />
                        <RadzenColumn Size="8" Offset="4" class="rz-white rz-p-0">
                        </RadzenColumn>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.Aktuell" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="@Localizer["Abgeschlossen"].Value" class="col-md-3 col-xs-12" Component="chkAbgeschlossen">@Localizer["Abgeschlossen"].Value</RadzenLabel>
                        <RadzenCheckBox @bind-Value="Saison.Abgeschlossen" Style="border-width:0px; width:40px;max-width:40px;margin-left:0px;" class="form-control  col-md-9 col-xs-12" Name="chkAbgeschlossen" />
                        <RadzenColumn Size="8" Offset="4" class="rz-white rz-p-0">
                        </RadzenColumn>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.Abgeschlossen" />
                        </div>
                    </div>
                    <div class="form-group row m-0 row mb-1">
                        <RadzenLabel Text="@Localizer["Spielplan vorhanden"].Value" class="col-md-3 col-xs-12" Component="txtSpielplanVorhanden">@Localizer["Spielplan vorhanden"].Value</RadzenLabel>
                        <RadzenCheckBox @bind-Value="Saison.SpielplanVorhanden" Style="border-width:0px; width:40px;max-width:40px;margin-left:0px;" class="form-control  col-md-9 col-xs-12" Name="chkAbgeschlossen" />
                        <RadzenColumn Size="8" Offset="4" class="rz-white rz-p-0">
                        </RadzenColumn>
                        <div class="col-12 col-md-9 offset-md-3 text-danger ps-3">
                            <ValidationMessage For="() => Saison.SpielplanVorhanden" />
                        </div>
                    </div>
                    <div class="form-group mt-3">
                        <RadzenButton title="@Localizer["Speichert Saison ab"].Value" style="margin-left:5px;" id="btnsave" Click="SaveGrunddaten" class="btn btn-primary" Text="@Localizer["Speichern"].Value">
                            <span class="glyphicon glyphicon-save"></span>@Localizer["Speichern"].Value
                        </RadzenButton>
                        <div class="form-group pt-2 my-3">

                            <RadzenButton title="@Localizer["Zurück zu Saisonenübersicht"].Value" style="margin-left:5px;" Click="GoBack" id="btnSpeichern" class="btn btn-secodary" Text="@Localizer["Zurück"].Value">
                                <span class="glyphicon glyphicon-left"></span>@Localizer["Zurück"].Value
                            </RadzenButton>
                        </div>
                    </div>

                </RadzenStepsItem>
                <RadzenStepsItem PreviousText="@Localizer["Voriger Schritt"].Value" NextText="@Localizer["Nächster Schritt"].Value">
                    <h2>@Localizer["Saison"].Value @Saison.Saisonname @Saison.Liganame</h2>
                    <h3>@Localizer["Vereine zuordnen"].Value</h3>
                    <br />
                    <br />
                    <div class="containervereine">
                        <div class="list-container">
                            <div class="form-group row align-items-center">
                                <div class="col-auto">
                                    <RadzenLabel for="txtSearch" Text="Suche" Component="txtSearch">@Localizer["Suche"].Value</RadzenLabel>
                                </div>

                                <div class="col">
                                    <div class="input-group">
                                        <input type="text" @bind="searchfeld" id="txtSearch" class="form-control search" />
                                        <span class="input-group-append">
                                            <button class="btn btn-outline-secondary" type="button" id="button-addon2">X</button>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div id="allVereine" class="list">
                                @foreach (var verein in VereineList.Where(v => string.IsNullOrEmpty(searchfeld) ||
                                                            v.Vereinname1.StartsWith(searchfeld, StringComparison.OrdinalIgnoreCase))
                                                            .OrderBy(v => v.Vereinname1))
                                {
                                    <div class="list-item @GetSelectedClass(verein)" @onclick="() => ToggleSelection(verein)">
                                        @verein.Vereinname1
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="list-container">
                            <h2>Ausgewählte Vereine (@SelectedVereine.Count/@Saison.AnzahlVereine)</h2>
                            <div class="list">
                                @foreach (var verein in SelectedVereine.OrderBy(v => v.Vereinname1))
                                {
                                    <div class="list-item" @onclick="() => ToggleSelection(verein)">
                                        @verein.Vereinname1
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </RadzenStepsItem>
                <RadzenStepsItem PreviousText="@Localizer["Voriger Schritt"].Value" NextText="@Localizer["Nächster Schritt"].Value">
                    <h2>@Localizer["Saison"].Value @Saison.Saisonname @Saison.Liganame</h2>
                    <h3>@Localizer["Zusammenfassung"].Value</h3>
                    <br />
                    <br />
