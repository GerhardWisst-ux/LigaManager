@page "/Ligamanager/vereineCL"
@using LigaManagerManagement.Web.Pages;
@using Radzen;
@inherits VereineListCLBase
@inject LigaManagerManagement.Web.Services.LigaManagerAuthenticationStateProvider _LigaManagerAuthenticationStateProvider
@inject NavigationManager _navigationManager

@attribute [Authorize]

<head>


    <script>
        function scrollToTop() {
            window.scrollTo(0, 0);
        }
    </script>

    <style type="text/css">
        .rz-datatable tr {
            min-height: 8%;
            word-break: break-all;
        }


        .icon-preview div {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            width: 120px;
        }

        .icon-preview span {
            color: var(--rz-text-disabled-color);
            font-size: 0.75rem;
        }

        .rz-datatable td {
            padding: 2.5px;
        }
    </style>

</head>

@if (IsLoading)
{
    <RadzenStack AlignItems="AlignItems.Center" Class="rz-m-12" Gap="2rem">
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </RadzenStack>
}
else
{
    <div class="container">
        <RadzenCard class="m-0 rz-shadow-3" style="height:auto;">
            <div class="d-flex flex-row">
                <div class="card-body">
                     <span style="color:#1151f3; background-color:transparent;" class="float-right">@Localizer["Eingeloggter Benutzer"].Value: @_LigaManagerAuthenticationStateProvider.CurrentUser.Username</span>
                            <br />
                            <NavLink href="@($"Ligamanager/account/logout")" style="margin-top:8px;" title="@Localizer["Ausloggen"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="logout" /><span></span></div></NavLink>
                            <NavLink href="@($"Ligamanager/einstellungen")" style="margin-top:8px;" title="@Localizer["Einstellungen"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="settings" /><span></span></div></NavLink>
                            <NavLink href="@($"Ligamanager/info")" style="margin-top:8px;" title="@Localizer["Info"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="info" /><span></span></div></NavLink>
                            <NavLink href="@($"InfoTexteList")" style="margin-top:8px;" title="@Localizer["InfoTexte"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="help" /><span></span></div></NavLink>
                    <h2 style="display:inline-block;">@Localizer["Vereine Champions League"].Value</h2>
                    <span class="ml-3">                        
                        <RadzenButton title="@Localizer["Neuanlage Verein"].Value" Click=@(args => OnClick("Primary icon button")) Icon="add_circle_outline" ButtonStyle="ButtonStyle.Primary" />
                    </span>
                </div>
            </div>
        </RadzenCard>

        <div class="form-group row">
            <div class="col-sm-12">

                  <RadzenCard class="my-4" style="display: flex; align-items: center; gap: 0.5rem">                        
                        <RadzenSelectBar @bind-Value="@Density" TextProperty="Text" ValueProperty="Value"
                                         Data="@(Enum.GetValues(typeof(Density)).Cast<Density>().Select(t => new { Text = $"{t}", Value = t }))" Size="ButtonSize.Medium" />
                    </RadzenCard>
            
                      <RadzenTabs>
                <Tabs>
                    <RadzenTabsItem Text="Champions Laegue">
                      <RadzenDataGrid @ref="gridCL" Data="@VereineListCL" class="table table-striped" FilterMode="FilterMode.Simple" PageSize="30"
                        AllowPaging="true" AllowSorting="true" Responsive=true Density="@Density" AllowFiltering="true"
                        TItem="Verein" Visible="true" AllowColumnResize="true"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        LogicalFilterOperator="LogicalFilterOperator.Or" SelectionMode="DataGridSelectionMode.Single" >
            <Columns>
                <RadzenDataGridColumn TItem="Verein" Property="VereinNr" Width="50px" TextAlign="TextAlign.Right" Filterable="false" Sortable=false Title=@Localizer["Nr"].Value></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Verein" Property="Vereinsname1" Width="250px" Sortable=true Title=@Localizer["Kurzname"].Value></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Verein" Property="Vereinsname2" Width="250px" Sortable=true Title=@Localizer["Anzeigename"].Value></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Verein" Property="Stadion" Width="200px" Sortable=true Title=@Localizer["Stadion"].Value></RadzenDataGridColumn>
                @* <RadzenDataGridColumn TItem="Verein" Property="Erfolge" Width="250px" HeaderTooltip="Europäische und nationale Titel"  TextAlign="TextAlign.Left" Filterable="true" Sortable=true Title="Erfolge" /> *@

                 <RadzenDataGridColumn TextAlign="TextAlign.Right" TItem="Verein" Property="Bundesliga" Title="2024" Width="15%" Filterable="false" Sortable="false">
                    <Template Context="data">
                        <RadzenCheckBox @bind-Value=@data.Bundesliga TValue="bool" Name="chkBundesliga" />
                    </Template>
                 </RadzenDataGridColumn>                

                 <RadzenDataGridColumn TextAlign="TextAlign.Right" TItem="Verein" Property="Pokal" Title="2023" Width="15%" Filterable="false" Sortable="false">
                    <Template Context="data">
                        <RadzenCheckBox @bind-Value=@data.Pokal TValue="bool" Name="chkPokal" />
                    </Template>
                 </RadzenDataGridColumn>
                
                <RadzenDataGridColumn TItem="Verein" Property="ID" Title="ID" Visible=false>                   
                </RadzenDataGridColumn Context="data" >

                <RadzenDataGridColumn TextAlign="TextAlign.Right" TItem="Verein" Property="Id" Width="100px" Filterable="false" Sortable="false">
                    <Template Context="data">
                        <NavLink id="btnEdit" style="height:35px;" href="@($"editvereinCL/{data.VereinNr}/{"DE"}")" title="@Localizer["Bearbeiten"].Value" class="btn btn-primary btn-sm"><div><RadzenIcon Icon="edit" title="@Localizer["Bearbeiten"].Value"  /></div></NavLink>
                        @* <NavLink id="btnChart" style="height:35px;" href="@($"Ligamanager/ChartVerein/{data.VereinNr}")" title="@Localizer["Chart Punkteentwicklung"].Value"  class="btn btn-primary btn-sm"><div><span class="oi oi-aperture" aria-hidden="true"></span></div></NavLink> *@
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
            <FooterTemplate>
             </FooterTemplate>
             <FooterTemplate>
                    @Localizer["Anzahl Vereine CL"].Value: <b>@VereineListCL.Count()</b>
             </FooterTemplate>
           
        </RadzenDataGrid>
          </RadzenTabsItem>
         </Tabs>
            </RadzenTabs>
            </div>
        </div>
    </div>

    @code {
    private void OnClick(string text)
    {
        _navigationManager.NavigateTo("createvereinCL/DE");
    }
}
    <script>

         window.onscroll = function () { scrollFunction(); };

    function scrollFunction() {
        const mybutton = document.getElementById("btnTop");
        if (!mybutton) return;  // Sicherstellen, dass Element da ist

        if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
            mybutton.style.display = "block";
        } else {
            mybutton.style.display = "none";
        }
    }

    function topFunction() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    </script>


}