@page "/Ligamanager/SpielplanList/{SaisonID}"
@using LigaManagerManagement.Web.Pages
@inject LigaManagerManagement.Web.Services.LigaManagerAuthenticationStateProvider _LigaManagerAuthenticationStateProvider
@inject DialogService DialogService
@inject NavigationManager _navigationManager

@inherits SpielplanListBase

<head>

</head>

<script>
    function scrollToTop() {
        window.scrollTo(0, 0);
    }
</script>

<style type="text/css">

    .rz-datatable tr {
        min-height: 8%;
        word-break: break-all;
    }

    tr.separated td {
        /* set border style for separated rows */
        border-bottom: 1px solid black;
    }

    table {
        /* make the border continuous (without gaps between columns) */
        border-collapse: collapse;
    }

    .rz-datatable td {
        padding: 2.5px;
    }
</style>

@if (IsLoading)
{
    <RadzenStack AlignItems="AlignItems.Center" Class="rz-m-12" Gap="2rem">
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </RadzenStack>
}
else
{
    <div class="container">

        <RadzenCard class="m-0 rz-shadow-3" style="height:120px;">
            <div class="d-flex flex-row">
                <div class="card-body">
                    <span style="background-color: #1151f3; color:white" class="float-right">@Localizer["Eingeloggter Benutzer"].Value: @_LigaManagerAuthenticationStateProvider.CurrentUser.Username</span>
                    <br />
                    <span class="float-right"><a href="Ligamanager/account/logout"><img style="height:25px;" title="@Localizer["Logout"].Value" src="images/Logout.png" /></a></span>
                    <span class="float-right mr-2"><a href="/Ligamanager/einstellungen"><img style="width:25px; height:25px;" title="@Localizer["Einstellungen"].Value" src="images/settings.png" /></a></span>
                    <span class="float-right mr-2"><a href="/Ligamanager/info"><img style="height:25px;" title="@Localizer["Info"].Value" src="images/info.png" /></a></span>
                    <h2 style="display:inline-block;">@Localizer["Spielpläne"].Value</h2>
                    <span class="ml-3">
                        <RadzenButton Click=@(args => OnClick("Primary icon button")) Icon="add_circle_outline" title="@Localizer["Neuanlage Spielplan"].Value" ButtonStyle="ButtonStyle.Primary" />
                    </span>
                </div>
            </div>
        </RadzenCard>

        <RadzenCard style="flex:1;margin-right:0px; height:auto;">
            <RadzenCard class="my-4" style="display: flex; align-items: center; gap: 0.5rem">
                <RadzenSelectBar @bind-Value="@Density" TextProperty="Text" ValueProperty="Value"
                                 Data="@(Enum.GetValues(typeof(Density)).Cast<Density>().Select(t => new { Text = $"{t}", Value = t }))" Size="ButtonSize.ExtraSmall" />
            </RadzenCard>

            <RadzenDataGrid @ref="grid" Data="@Spielplaene" EmptyText="@Localizer["Keine Ergebnisse zum Anzeigen"].Value" class="table table-striped" FilterMode="FilterMode.Advanced" PageSize="9"
                            AllowPaging="true" AllowSorting="true" AllowFiltering="false"
                            TItem="Spielplan" Visible="true" Responsive=true AllowColumnResize="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            SelectionMode="DataGridSelectionMode.Single" Density="@Density" LogicalFilterOperator="LogicalFilterOperator.Or">
                <Columns>
                    <RadzenDataGridColumn TItem="Spielplan" Property="SpieltagNr" Width="50px" TextAlign="TextAlign.Right" Filterable="false" Sortable=false Title="SpieltagNr" />
                    <RadzenDataGridColumn TItem="Spielplan" CssClass="VereinMinWidth" Property="Verein1Anzeige" Width="30%" Sortable=true Title="@Localizer["Heim"].Value">

                    </RadzenDataGridColumn>
                    @if (Globals.LigaNummer == 20 || Globals.LigaNummer == 21)
                    {
                        <RadzenDataGridColumn TItem="Spielplan" Title="" Sortable="true" Width="44px" MinWidth="44px">
                            <Template Context="data">
                                <RadzenImage Path="@($"/Images/NoImage.webp")" style="width: 30px; height: 30px;" title="@data.Verein1" AlternateText="@(data.Verein1)" />
                            </Template>
                        </RadzenDataGridColumn>
                    }
                    else
                    {
                        <RadzenDataGridColumn TItem="Spielplan" Title="" Sortable="true" Width="44px" MinWidth="44px">
                            <Template Context="data">
                                <RadzenImage Path="@($"/Images/{data.Verein1}.webp")" style="width: 30px; height: 30px;" title="@data.Verein1" AlternateText="@(data.Verein1)" />
                            </Template>
                        </RadzenDataGridColumn>
                    }

                    <RadzenDataGridColumn TItem="Spielplan" CssClass="FarbeTorePunkt" Property="Tore1_Nr" TextAlign="TextAlign.Right" Width="22px" Sortable=true />
                    <RadzenDataGridColumn TItem="Spielplan" CssClass="FarbeTorePunkt" Property="Doppelpunkt" TextAlign="TextAlign.Center" Width="10px" Sortable=false />
                    <RadzenDataGridColumn TItem="Spielplan" CssClass="FarbeTorePunkt" Property="Tore2_Nr" TextAlign="TextAlign.Left" Width="22px" Sortable=true />
                                      
                    @if (Globals.LigaNummer == 20 || Globals.LigaNummer == 21)
                    {
                        <RadzenDataGridColumn TItem="Spielplan" Title="" Sortable="true" Width="44px" MinWidth="44px">
                            <Template Context="data">
                                <RadzenImage Path="@($"/Images/NoImage.webp")" style="width: 30px; height: 30px;" title="@data.Verein2" AlternateText="@(data.Verein2)" />
                            </Template>
                        </RadzenDataGridColumn>
                    }
                    else
                    {
                        <RadzenDataGridColumn TItem="Spielplan" Title="" Sortable="true" Width="44px" MinWidth="44px">
                            <Template Context="data">
                                <RadzenImage Path="@($"/Images/{data.Verein2}.webp")" style="width: 30px; height: 30px;" title="@data.Verein2" AlternateText="@(data.Verein2)" />
                            </Template>
                        </RadzenDataGridColumn>
                    }

                    <RadzenDataGridColumn TItem="Spielplan" CssClass="VereinMinWidth" Property="Verein2Anzeige" Width="25%" Sortable=true Title="@Localizer["Auswärts"].Value" />

                    <RadzenDataGridColumn TItem="Spielplan" FormatString="{0:dd.MM.yyyy}" Property="DatumString" Width="18%" Sortable=true Title=@Localizer["Datum"].Value />
                    <RadzenDataGridColumn TItem="Spielplan" Property="Ort" Width="30%" Sortable=true Title=@Localizer["Ort"].Value />

                    <RadzenDataGridColumn TextAlign="TextAlign.Right" TItem="Spielplan" Property="SpieltagId" Width="80px" Filterable="false" Sortable="false">
                        <Template Context="data">
                            <NavLink href="@($"Ligamanager/editspielplantag/{data.SpieltagId}")" title="@Localizer["Bearbeiten"].Value" class="btn btn-primary btn-sm"><div><RadzenIcon Icon="launch" /><span></span></div></NavLink>
                        </Template>
                    </RadzenDataGridColumn>
                    <hr style="border:5px;" />
                </Columns>
            </RadzenDataGrid>

            <div class="row">
                <div class="col-md-1">
                    <a type="button" id="btnZurueck" Style="text-align:left;display:inline-block;" data-toggle=@Localizer["Voriger Spieltag"] title="@Localizer["Voriger Spieltag"]" @onclick="SpieltagZurueck" class="previous round">&laquo;</a>
                </div>
                <div class="col-md-11 text-right">
                    <a type="button" id="btnVor" data-toggle="@Localizer["Nächster Spieltag"]" title="@Localizer["Nächster Spieltag"]" @onclick="SpieltagVor" style="width: auto; text-align:left;display:inline-block;" class="next round">&raquo;</a>
                </div>
            </div>
        </RadzenCard>
    </div>
}
@code {    
    private void OnClick(string text)
    {

        _navigationManager.NavigateTo("Ligamanager/createstadion");
    }
}