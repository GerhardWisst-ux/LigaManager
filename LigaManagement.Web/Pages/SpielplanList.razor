@page "/Ligamanager/SpielplanList/{SaisonID}"
@using LigaManagerManagement.Web.Pages
@inject LigaManagerManagement.Web.Services.LigaManagerAuthenticationStateProvider _LigaManagerAuthenticationStateProvider
@inject DialogService DialogService
@inject NavigationManager _navigationManager

@inherits SpielplanListBase

<head>

</head>

<script>
    function scrollToTop() {
    window.scrollTo(0, 0);
    }
</script>


<style type="text/css" >


    .NewBtn {
        gap: 1px;
        margin-right: 2px;
        align-self: end;
        justify-content: end;
        margin-right: 0px !important;
    }

    #btnVor, #btnZurueck {
        text-decoration: none;
        display: inline-block;
        padding: 8px 16px;
    }

    a:hover {
        background-color: #ddd;
        color: black;
    }

    .previous, .next {
        background-color: #1b6ec2;
        border-color: #1861ac;
        color: white !important;
    }

    .round {
        border-radius: 50%;
    }

    .VereinMinWidth {
        min-width: 80px;
        font-weight: normal;
    }

    .Doublepoint {
        font-weight: bold !important;
        background: black;
        background-color: black !important;
        color: white !important;
    }

    .rz-data-grid-data {
        border-collapse: revert !important;
    }

    .rz-datatable td {
        padding: 3.5px !important;
    }
   

</style>

@if (IsLoading)
{
    <RadzenStack AlignItems="AlignItems.Center" Class="rz-m-12" Gap="2rem">
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </RadzenStack>
}
else
{
    <div class="container">

        <RadzenCard class="m-0 rz-shadow-3" style="height:120px;">
            <div class="d-flex flex-row">
                <div class="card-body">
                    <span style="color:#1151f3; background-color:transparent;" class="float-right">@Localizer["Eingeloggter Benutzer"].Value: @_LigaManagerAuthenticationStateProvider.CurrentUser.Username</span>
                    <br />
                    <NavLink href="@($"Ligamanager/account/logout")" style="margin-top:8px;" title="@Localizer["Ausloggen"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="logout" /><span></span></div></NavLink>
                    <NavLink href="@($"Ligamanager/einstellungen")" style="margin-top:8px;" title="@Localizer["Einstellungen"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="settings" /><span></span></div></NavLink>
                    <NavLink href="@($"Ligamanager/info")" style="margin-top:8px;" title="@Localizer["Info"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="info" /><span></span></div></NavLink>
                    <NavLink href="@($"InfoTexteList")" style="margin-top:8px;" title="@Localizer["InfoTexte"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="help" /><span></span></div></NavLink>
                    <h2 style="display:inline-block;">@Titel</h2>
                    <span class="ml-3">
                        <RadzenButton Click=@(args => OnClick("Primary icon button")) Icon="add_circle_outline" title="@Localizer["Neuanlage Spiel"].Value" ButtonStyle="ButtonStyle.Primary" />
                    </span>
                </div>
            </div>
        </RadzenCard>

        <RadzenCard style="margin-bottom:4px;height:80px;">
            <div class="form-group row">
                <div class="dropdown mr-2" style="display:inline; margin-left:4px;">
                    <select id="cboSpieltage" data-toggle="tooltip" title=@Localizer["Spieltag"].Value style="height:38px; width:180px; display:inline-block;" class="form-control" @onchange="SpieltagChange">
                        <option value="0" selected="selected">@Localizer["Spieltag wählen"].Value</option>
                        if (@SpielplanList != null)
                            {
                            @foreach (var spieltag in SpielplanList)
                            {
                                @if (spieltag.Nummer == @SpieltagNr)
                                {
                                    <option selected value="@spieltag.Nummer"> @spieltag.Name</option>
                                }
                                else
                                {
                                    <option value="@spieltag.Nummer"> @spieltag.Name</option>
                                }
                            }
                        }
                    </select> 
                </div>
            </div>
        </RadzenCard>
                
        <div class="form-group row">
            <div class="col-sm-12">
                <RadzenCard style="flex:1;margin-right:0px; height:auto;">
                    <RadzenCard class="my-4" style="display: flex; align-items: center; gap: 0.5rem">
                        <RadzenSelectBar @bind-Value="@Density" TextProperty="Text" ValueProperty="Value"
                                         Data="@(Enum.GetValues(typeof(Density)).Cast<Density>().Select(t => new { Text = $"{t}", Value = t }))" Size="ButtonSize.ExtraSmall" />
                    </RadzenCard>

                    <RadzenDataGrid @ref="grid" Data="@Spielplaene" EmptyText="@Localizer["Keine Ergebnisse zum Anzeigen"].Value" class="table table-striped" FilterMode="FilterMode.Advanced" PageSize="9"
                                    AllowPaging="true" AllowSorting="true" AllowFiltering="false"
                                    TItem="Spielplan" Visible="true" Responsive=true AllowColumnResize="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    SelectionMode="DataGridSelectionMode.Single" Density="@Density" LogicalFilterOperator="LogicalFilterOperator.Or">
                        <Columns>
                           
                            <RadzenDataGridColumn TItem="Spielplan" Property="SpieltagNr" Width="10%" TextAlign="TextAlign.Left" Filterable="false" Visible=true Sortable=false Title="SpieltagNr" />
                            <RadzenDataGridColumn TItem="Spielplan" CssClass="VereinMinWidth" Property="Verein1Anzeige" Width="23%" Sortable=true Title="@Localizer["Heim"].Value">
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="Spielplan" Title="" Sortable="true" Width="44px" MinWidth="44px">
                                <Template Context="data">
                                    <RadzenImage Path="@($"/Images/{data.Verein1}.webp")" style="width: 30px; height: 30px;" title="@data.Verein1" AlternateText="@(data.Verein1)" />
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="Spielplan" Title="" Sortable="true" Width="44px" MinWidth="44px">
                                <Template Context="data">
                                    <RadzenImage Path="@($"/Images/{data.Verein2}.webp")" style="width: 30px; height: 30px;" title="@data.Verein2" AlternateText="@(data.Verein2)" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="Spielplan" CssClass="VereinMinWidth" Property="Verein2Anzeige" Width="23%" Sortable=true Title="@Localizer["Auswärts"].Value" />

                            <RadzenDataGridColumn TItem="Spielplan" Property="DatumString" Width="18%" Sortable=true Title=@Localizer["Datum"].Value />
                            <RadzenDataGridColumn TItem="Spielplan" Property="Ort" Width="15%" Sortable=true Title=@Localizer["Ort"].Value />

                            <RadzenDataGridColumn TextAlign="TextAlign.Right" TItem="Spielplan" Property="SpieltagId" Width="20%" Filterable="false" Sortable="false">
                                <Template Context="data">
                                    <NavLink href="@($"Ligamanager/editspielplan/{data.SaisonID}/{data.SpieltagId}")" title="@Localizer["Bearbeiten"].Value" class="btn btn-primary btn-sm"><div><RadzenIcon Icon="edit" title="@Localizer["Bearbeiten"].Value"  /></div></NavLink>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                        <FooterTemplate>
                        </FooterTemplate>
                        <FooterTemplate>
                            @Localizer["Anzahl Spiele"]: <b>@Spielplaene.Count()</b>
                        </FooterTemplate>
                    </RadzenDataGrid>
                    <div class="row">
                        <div class="col-md-1">
                            <a type="button" id="btnZurueck" Style="text-align:left;display:inline-block;" data-toggle=@Localizer["Voriger Spieltag"] title="@Localizer["Voriger Spieltag"]" @onclick="SpieltagZurueck" class="previous round">&laquo;</a>
                        </div>
                        <div class="col-md-11 text-right">
                            <a type="button" id="btnVor" data-toggle="@Localizer["Nächster Spieltag"]" title="@Localizer["Nächster Spieltag"]" @onclick="SpieltagVor" style="width: auto; text-align:left;display:inline-block;" class="next round">&raquo;</a>
                        </div>
                    </div>
                </RadzenCard>
                @* </div> *@
            </div>
        </div>
    </div>

   
}
@code {
    private void OnClick(string text)
    {

        _navigationManager.NavigateTo($"Ligamanager/createSpielplan/{SaisonID}/{SpieltagNr}");
    }

    
}