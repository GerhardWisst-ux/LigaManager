                                                    <RadzenDataGridColumn TItem="PokalergebnisStatistik" Property="Platz" TextAlign="TextAlign.Right" Width="22px" Sortable="true">
                                                        <HeaderTemplate>
                                                            <div style="padding: 4px 8px;">
                                                                @Localizer["Platz"].Value
                                                            </div>
                                                        </HeaderTemplate>
                                                        <Template Context="data">
                                                            <div style="padding: 4px 8px;">
                                                                @string.Format("{0:0}", data.Platz)
                                                            </div>
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="PokalergebnisStatistik" Title="" Sortable="true" Width="5%">
                                                        <Template Context="data">
                                                            <RadzenImage Path="@($"/Images/{data.Verein}.webp")" style="height: 30px; width: 30px;" title="@data.Verein" AlternateText="@(data.Verein)" />
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn  TItem="PokalergebnisStatistik" Property="Verein" Width="25%" Sortable=false Title="@Localizer["Verein"].Value" />
                                                    <RadzenDataGridColumn TItem="PokalergebnisStatistik" Property="Siege" TextAlign="TextAlign.Right" Width="32px" Sortable="true">
                                                        <HeaderTemplate>
                                                            <div style="padding: 4px 8px;">
                                                                @Localizer["Siege"].Value
                                                            </div>
                                                        </HeaderTemplate>
                                                        <Template Context="data">
                                                            <div style="padding: 4px 8px;">
                                                                @string.Format("{0:0}", data.Siege)
                                                            </div>
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="PokalergebnisStatistik" Property="Finalteilnahmen" TextAlign="TextAlign.Right" Width="52px" Sortable="true">
                                                        <HeaderTemplate>
                                                            <div style="padding: 4px 8px;">
                                                                @Localizer["Finalteilnahmen"].Value
                                                            </div>
                                                        </HeaderTemplate>
                                                        <Template Context="data">
                                                            <div style="padding: 4px 8px;">
                                                                @string.Format("{0:0}", data.Finalteilnahmen)
                                                            </div>
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="PokalergebnisStatistik" Property="Siegquote" TextAlign="TextAlign.Right" Width="32px" Sortable="false">
                                                        <HeaderTemplate>
                                                            <div style="padding: 4px 8px;">
                                                                @Localizer["Siegquote"].Value
                                                            </div>
                                                        </HeaderTemplate>
                                                        <Template Context="data">
                                                            <div style="padding: 4px 8px;">
                                                                @string.Format("{0:0.00} %", data.Siegquote)
                                                            </div>
                                                        </Template>
                                                    </RadzenDataGridColumn>

                                                </Columns>
                                                <FooterTemplate>
                                                </FooterTemplate>

                                            </RadzenDataGrid>
                                        </RadzenCard>
                                    </div>
                                </div>
                            </RadzenTabsItem>
                        </Tabs>
                    </RadzenTabs>
                </RadzenCard>
            </div>
        </div>
    </div>




}

<script>
