                                                            <div style="padding: 4px 8px;">
                                                                @data.Ort
                                                            </div>
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="PokalergebnisSpieltag" Property="Datum" TextAlign="TextAlign.Left" Width="25%" Sortable="false">
                                                        <HeaderTemplate>
                                                            <div style="padding: 4px 8px;">
