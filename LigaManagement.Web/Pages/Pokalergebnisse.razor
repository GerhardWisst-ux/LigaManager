                                                            </div>
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TextAlign="TextAlign.Center" CssClass="table-row" TItem="PokalergebnisSpieltag" Property="SpieltagId" Width="80px" Filterable="false" Sortable="false">
                                                        <Template Context="data">
                                                            <NavLink href="@($"editpokalspieltag/{data.SpieltagId}")" title="@Localizer["Bearbeiten"].Value" class="btn btn-primary btn-sm"><div><RadzenIcon Icon="edit" title="@Localizer["Bearbeiten"].Value" /></div></NavLink>
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                </Columns>
                                                <FooterTemplate>
                                                </FooterTemplate>
                                                <FooterTemplate>
                                                    @Localizer["Anzahl Spiele"]: <b>@PokalergebnisseSpieltage?.Count()</b>
                                                    @Localizer["Anzahl Heimerfolge"]: <b>@PokalergebnisseSpieltage?.Where(x => x.Tore1_Nr > x.Tore2_Nr)?.Count()</b>
                                                    @Localizer["Anzahl Auswärtserfolge"]: <b>@PokalergebnisseSpieltage?.Where(x => x.Tore1_Nr < x.Tore2_Nr)?.Count()</b>
                                                </FooterTemplate>
                                            </RadzenDataGrid>
                                        </RadzenCard>
                                        <div class="row">
                                            <div class="col-md-1">
                                                <a type="button" id="btnZurueck" Style="text-align:left;display:inline-block;width:40px;height:40px;" data-toggle=@Localizer["Vorige Runde"] title="@Localizer["Voriger Runde"]" @onclick="RundeZurueck" class="previous round">&laquo;</a>
                                            </div>
                                            <div class="col-md-11 text-right">
                                                <a type="button" id="btnVor" data-toggle="@Localizer["Nächster Spieltag"]" title="@Localizer["Nächste Runde"]" @onclick="RundeVor" style="width: 40px;height:40px; text-align:left;display:inline-block;" class="next round">&raquo;</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
