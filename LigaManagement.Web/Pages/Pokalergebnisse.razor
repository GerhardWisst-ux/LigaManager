@page "/Ligamanager/pokalergebnisse"
@using LigaManagerManagement.Web.Pages;
@using Microsoft.AspNetCore.Hosting
@using Radzen;
@using Radzen.Blazor;
@using Radzen.Blazor.Rendering;

@inject IWebHostEnvironment Env
@inherits PokalergebnisseListBase

@inject DialogService DialogService
@inject LigaManagerManagement.Web.Services.LigaManagerAuthenticationStateProvider _LigaManagerAuthenticationStateProvider
@inject NavigationManager _navigationManager

@attribute [Authorize]

<head>

</head>

<style>
    tr.separated td {
        /* set border style for separated rows */
        border-bottom: 1px solid black;
    }

    table {
        /* make the border continuous (without gaps between columns) */
        border-collapse: collapse;
    }

    .rz-datatable td {
        padding: 2.5px;
    }

    .FarbeTorePunkt {
        color: white !important;
        width: auto !important;
        border-top-color: black !important;
        border-bottom-color: black !important;
        border-left-color: black !important;
        border-right-color: black !important;
        background-color: black !important;
        --rz-grid-cell-color: white;
    }

    .previous, .next {
        background-color: #1b6ec2;
        border-color: #1861ac;
        color: white !important;
    }

    .round {
        border-radius: 50%;
    }

    .spielentscheidung {
        font-size: 0.8em;
        color: gray;
        font-style: italic;
        line-height: 1;
    }
</style>

@if (IsLoading)
{
    <RadzenStack AlignItems="AlignItems.Center" Class="rz-m-12" Gap="2rem">
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </RadzenStack>
}
else
{
    <div class="container">
        <div class="form-group row">
            <div class="col-sm-12">
                <RadzenCard class="m-0 rz-shadow-3" style="height:auto;">
                    <div class="d-flex flex-row">
                        <div class="card-body">
                            <span style="color:#1151f3; background-color:transparent;" class="float-right">@Localizer["Eingeloggter Benutzer"].Value: @_LigaManagerAuthenticationStateProvider.CurrentUser.Username</span>
                            <br />
                            <NavLink href="@($"Ligamanager/account/logout")" style="margin-top:8px;" title="@Localizer["Ausloggen"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="logout" /><span></span></div></NavLink>
                            <NavLink href="@($"Ligamanager/einstellungen")" style="margin-top:8px;" title="@Localizer["Einstellungen"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="settings" /><span></span></div></NavLink>
                            <NavLink href="@($"Ligamanager/info")" style="margin-top:8px;" title="@Localizer["Info"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="info" /><span></span></div></NavLink>
                            <NavLink href="@($"InfoTexteList")" style="margin-top:8px;" title="@Localizer["InfoTexte"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="help" /><span></span></div></NavLink>
                            <h2 style="display:inline-block;">@Localizer["Pokalergebnisse"].Value @Ligamanager.Components.Globals.currentPokalSaison</h2>
                            <span class="ml-3">
                                <RadzenButton Click=@(args => OnClick("Primary icon button")) Icon="add_circle_outline" Visible=true Style="display:inline-block;" title="@Localizer["Neuanlage Pokalspiel"].Value" ButtonStyle="ButtonStyle.Primary" />
                            </span>
                        </div>
                    </div>
                </RadzenCard>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-sm-12">
                <RadzenCard style="margin-bottom:4px;">
                    <div class="form-group row">
                        <div class="dropdown mr-2  ml-3" style="display:inline">
                            <select id="cboSaison" class="form-control dropdown" @onchange="SaisonChange">
                                <option value="" selected required>@Localizer["Saison wählen"].Value</option>
                                @if (SaisonenList != null)
                                {
                                    @foreach (var saison in SaisonenList.OrderByDescending(o => o.Saisonname))
                                    {
                                        @if (saison.SaisonID == Globals.CLPokalSaisonID)
                                        {
                                            <option selected value="@saison.SaisonID"> @saison.Saisonname </option>
                                        }
                                        else
                                        {
                                            <option value="@saison.SaisonID"> @saison.Saisonname </option>
                                        }
                                    }
                                }
                            </select>
                            <label style="display:@DisplayErrorSaison;color:red;" id="lblErrorSaison">@Localizer["Saison wählen"].Value</label>
                        </div>
                        <div class="dropdown" style="display:inline">
                            <select id="cboTableArt" style="display:inline; width:180px;height:38px;" class="form-control dropdown" @onchange="RundeChange">
                                <option value="0" required>@Localizer["Runde wählen"].Value</option>
                                @if (RundeList != null)
                                {
                                    @foreach (var runde in RundeList)
                                    {
                                        @if (runde.RundeKurzbezeichung == RundeChoosed)
                                        {
                                            <option selected value="@runde.RundeKurzbezeichung"> @runde.Rundename </option>
                                        }
                                        else
                                        {
                                            <option value="@runde.RundeKurzbezeichung"> @runde.Rundename </option>
                                        }
                                    }
                                }
                            </select>
                            <label style="display:@DisplayErrorRunde;color:red;" id="lblErrorSaison">@Localizer["Runde wählen"].Value</label>
                        </div>
                        <div class="dropdown" style="display:inline">
                            <RadzenButton title=@Localizer["Saison und Runde auswählen"].Value style="margin-left: 5px;" id="btnUebernehmen" class="btn btn-primary pull-right" Click="@OnClickHandler">
                                <i class="oi oi-magnifying-glass" style="margin-left: 1px;  vertical-align:text-bottom;"></i>
                            </RadzenButton>
                        </div>

                    </div>
                </RadzenCard>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-sm-12">
                <RadzenCard>
                    <RadzenTabs>
                        <Tabs>
                            <RadzenTabsItem class="p-0" Text=@Localizer["Begegnungen"].Value>
                                <div class="form-group row">
                                    <div class="col-sm-12">
                                        <RadzenCard style="flex:1;margin:0px;">
                                            <RadzenDataGrid @ref="grid" Data="@PokalergebnisseSpieltage" EmptyText=@Localizer["Keine Daten zum Anzeigen"].Value class="table table-striped" FilterMode="FilterMode.Simple" PageSize="30"
                                                            AllowPaging="true" AllowSorting="false" AllowFiltering="false"
                                                            TItem="PokalergebnisSpieltag" Visible="true" Responsive=true AllowColumnResize="true"
                                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                            SelectionMode="DataGridSelectionMode.Single" CellRender="@CellRender" Density="@Density" LogicalFilterOperator="LogicalFilterOperator.Or">
                                                <Columns>
                                                    <RadzenDataGridColumn TItem="PokalergebnisSpieltag" Property="Verein1" TextAlign="TextAlign.Left" Width="25%" Sortable="false">
                                                        <HeaderTemplate>
                                                            <div style="padding: 4px 8px;">
                                                                @Localizer["Heim"].Value
                                                            </div>
                                                        </HeaderTemplate>
                                                        <Template Context="data">
                                                            <div style="padding: 4px 8px;">
                                                                @data.Verein1
                                                            </div>
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="PokalergebnisSpieltag" Title="" Sortable="false" Width="50px" MinWidth="50px">
                                                        <Template Context="data">
                                                            @if (!FileExists(data.Verein1))
                                                            {
                                                                <RadzenImage Path="/Images/NoImage.webp"
                                                                             style="width: 30px; height: 30px;"
                                                                             title="@data.Verein1"
                                                                             AlternateText="@data.Verein1" />
                                                            }
                                                            else
                                                            {
                                                                <RadzenImage Path="@($"/Images/{data.Verein1}.webp")"
                                                                             style="width: 30px; height: 30px;"
                                                                             title="@data.Verein1"
                                                                             AlternateText="@data.Verein1" />
                                                            }
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="PokalergebnisSpieltag" CssClass="FarbeTorePunkt" TextAlign="TextAlign.Center" Width="27px" Sortable="false" Title="">
                                                        <Template Context="data">
                                                            <div style="line-height: 1.2;">
                                                                <div>@data.Tore1_Nr</div>
                                                                <div class="spielentscheidung" title="@EntscheidungsText(data)">
                                                                    @EntscheidungsSymbol(data)
                                                                </div>
                                                            </div>
                                                        </Template>
                                                    </RadzenDataGridColumn>                                                    
                                                    <RadzenDataGridColumn TItem="PokalergebnisSpieltag" CssClass="FarbeTorePunkt" Property="Doppelpunkt" TextAlign="TextAlign.Center" Width="20px" Sortable=false />
                                                    <RadzenDataGridColumn TItem="PokalergebnisSpieltag" CssClass="FarbeTorePunkt" Property="Tore2_Nr" TextAlign="TextAlign.Center" Width="27px" Sortable=true />

                                                    <RadzenDataGridColumn TItem="PokalergebnisSpieltag" Title="" Sortable="true" TextAlign="TextAlign.Left" Width="44px">
