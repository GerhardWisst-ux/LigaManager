@page "/Ligamanager/ChartVerein/{VereinNr}"
@using LigaManagerManagement.Web.Pages

@using System.Text.Json

@inject LigaManagerManagement.Web.Services.LigaManagerAuthenticationStateProvider _LigaManagerAuthenticationStateProvider
@inject DialogService DialogService
@inject NavigationManager _navigationManager
@inherits LigaManagerManagement.Web.Pages.ChartVerein

<html>
<head>
    <style type="text/css">

        .rz-column-title-content {
            font-weight: bold !important;
        }

        #mapid {
            width: 100%;
            height: 400px; /* Festgelegte Höhe für korrekte Anzeige */
        }


        td.details-control {
            cursor: pointer;
            font-weight: bold;
        }

        .child-table {
            margin: 10px 20px;
        }

       .FarbeTorePunkt {
            color: white !important;
            width: auto !important;
            border-top-color: black !important;
            border-bottom-color: black !important;
            border-left-color: black !important;
            border-right-color: black !important;
            background-color: black !important;
            --rz-grid-cell-color: white;
         }
    </style>

</head>
<body>
    @if (IsLoading)
    {
        <RadzenStack AlignItems="AlignItems.Center" Class="rz-m-12" Gap="2rem">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        </RadzenStack>
    }
    else
    {
        <div class="container">
            <div class="form-group row">
                <div class="col-sm-12">
                    <RadzenCard class="m-0 rz-shadow-3" style="height:120px;">
                        <div class="d-flex flex-row">
                            <div class="card-body">
                                <span style="background-color: #1151f3; color:white;" class="float-right">@Localizer["Eingeloggter Benutzer"].Value: @_LigaManagerAuthenticationStateProvider.CurrentUser.Username</span>
                                <br />
                                <span class="float-right"><a href="Ligamanager/account/logout"><img style="height:25px;margin-top:8px;" title="@Localizer["Logout"].Value" src="images/Logout.png" /></a></span>
                                <span class="float-right mr-2"><a href="/Ligamanager/einstellungen"><img style="width:25px; height:25px;margin-top:8px;" title="@Localizer["Einstellungen"].Value" src="images/settings.png" /></a></span>
                                <span class="float-right mr-2"><a href="/Ligamanager/info"><img style="height:25px;margin-top:8px;" title="@Localizer["Info"].Value" src="images/info.png" /></a></span>
                                <h2 style="display:inline-block;">@Localizer["Mannschaftsstatistik:"].Value @Vereinsname </h2>
                            </div>
                        </div>
                    </RadzenCard>
                    <RadzenCard style="height:80px;">
                        <div Style="display:inline-block;" class="row">
                            <div Style="display:inline-block;" class="col-md-1">
                                <RadzenButton title="@Localizer["Vereine"].Value" Click=@(args => AnzeigenVereine()) Style="margin-left: 3px;height:38px;display:inline-block;" Text="@Localizer["Vereine"].Value" ButtonStyle="ButtonStyle.Primary">
                                    <span class="oi oi-bar-chart" aria-hidden="true"></span>@Localizer["Vereine"].Value
                                </RadzenButton>
                            </div>
                        </div>
                    </RadzenCard>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-sm-12">
                    <RadzenTabs Change="OnTabChange">
                        <Tabs>
                            <RadzenTabsItem Text=@Localizer["Vereinsinfo"].Value>
                                <RadzenRow Gap="0" Style="font-weight: bold; padding: 0 0 10px 0; border-bottom: 1px solid #ccc;">
                                    <RadzenColumn Size="6" SizeXS="6">
                                        <RadzenText TextStyle="TextStyle.Body1"></RadzenText>
                                    </RadzenColumn>
                                    <RadzenColumn Size="6" SizeXS="6">
                                        <RadzenText class="rz-column-title-content" TextAlign="TextAlign.Right" TextStyle="TextStyle.Body1"></RadzenText>
                                    </RadzenColumn>
                                </RadzenRow>
                                <RadzenDataList AllowVirtualization=@allowVirtualization
                                                WrapItems="@(!allowVirtualization)" AllowPaging="@(!allowVirtualization)"
                                                Data="@Vereinsinfo" TItem="LVereinsinfo" PageSize="10" PagerHorizontalAlign="HorizontalAlign.Left" PageSizeText="Größe" ShowPagingSummary="true">
                                    <Template Context="LVereinsinfo">
                                        <RadzenCard Style="width:100%; padding:0;">
                                            <RadzenRow Gap="0">
                                                <RadzenColumn Size="4" SizeXS="4">
                                                    <RadzenText TextAlign="TextAlign.Left" TextStyle="TextStyle.Body2">@(LVereinsinfo.StatText)</RadzenText>
                                                </RadzenColumn>
                                                <RadzenColumn Size="8" SizeXS="8">
                                                    <RadzenText TextAlign="TextAlign.Left" TextStyle="TextStyle.Body2">@(LVereinsinfo.Eigenschaft)</RadzenText>
                                                </RadzenColumn>
                                            </RadzenRow>
                                        </RadzenCard>
                                    </Template>
                                </RadzenDataList>
                                <div id="mapid"></div>
                            </RadzenTabsItem>
                            <RadzenTabsItem Text=@Localizer["Statistik"].Value>
                                <h3 style="display:inline-block;">@Localizer["Saison"].Value @Globals.currentSaison</h3>
                                <RadzenRow Gap="0" Style="font-weight: bold; padding: 0 0 10px 0; border-bottom: 1px solid #ccc;">
                                    <RadzenColumn Size="3" SizeXS="3">
                                        <RadzenText TextStyle="TextStyle.Body1"></RadzenText>
                                    </RadzenColumn>
                                    <RadzenColumn Size="3" SizeXS="3">
                                        <RadzenText class="rz-column-title-content" TextAlign="TextAlign.Right" TextStyle="TextStyle.Body1">Gesamt</RadzenText>
                                    </RadzenColumn>
                                    <RadzenColumn Size="3" SizeXS="3">
                                        <RadzenText class="rz-column-title-content" TextAlign="TextAlign.Right" TextStyle="TextStyle.Body1">Heim</RadzenText>
                                    </RadzenColumn>
                                    <RadzenColumn Size="3" SizeXS="3">
                                        <RadzenText class="rz-column-title-content" TextAlign="TextAlign.Right" TextStyle="TextStyle.Body1">Auswärts</RadzenText>
                                    </RadzenColumn>
                                </RadzenRow>
                                <RadzenDataList AllowVirtualization=@allowVirtualization
                                                WrapItems="@(!allowVirtualization)" AllowPaging="@(!allowVirtualization)"
                                                Data="@StatistikAktSaison" TItem="Mannschaftsstatistik" PageSize="10" PagerHorizontalAlign="HorizontalAlign.Left" PageSizeText="Größe" ShowPagingSummary="true">
                                    <Template Context="Mannschaftsstatistik">
                                        <RadzenCard Style="width:100%; padding:0;">
                                            <RadzenRow Gap="0">
                                                <RadzenColumn Size="3" SizeXS="3">
                                                    <RadzenText TextAlign="TextAlign.Left" TextStyle="TextStyle.Body2">@(Mannschaftsstatistik.StatText)</RadzenText>
                                                </RadzenColumn>
                                                <RadzenColumn Size="3" SizeXS="3">
                                                    <RadzenText TextAlign="TextAlign.Right" TextStyle="TextStyle.Body2">@(Mannschaftsstatistik.Gesamt)</RadzenText>
                                                </RadzenColumn>
                                                <RadzenColumn Size="3" SizeXS="3">
                                                    <RadzenText TextAlign="TextAlign.Right" TextStyle="TextStyle.Body2">@(Mannschaftsstatistik.Heim)</RadzenText>
                                                </RadzenColumn>
                                                <RadzenColumn Size="3" SizeXS="3">
                                                    <RadzenText TextAlign="TextAlign.Right" TextStyle="TextStyle.Body2">@(Mannschaftsstatistik.Auswaerts)</RadzenText>
                                                </RadzenColumn>
                                            </RadzenRow>
                                        </RadzenCard>
                                    </Template>
                                </RadzenDataList>

                                <RadzenLabel Text=@Localizer["Spiele"].Value Style="font-weight:bold;" />

                                <RadzenDataGrid @ref="gridSpieltage" Data="@Spieltage" EmptyText="@Localizer["Keine Ergebnisse zum Anzeigen"].Value" class="table table-striped" FilterMode="FilterMode.Advanced" PageSize="34"
                                                AllowPaging="true" AllowSorting="true" AllowFiltering="false"
                                                TItem="Spieltag" Visible="true" Responsive=true AllowColumnResize="true"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                SelectionMode="DataGridSelectionMode.Single" Density="@Density" LogicalFilterOperator="LogicalFilterOperator.Or">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="Spieltag" Property="SpieltagId" Width="50px" TextAlign="TextAlign.Right" Filterable="false" Visible=false Sortable=false Title="SpieltagId" />
                                        <RadzenDataGridColumn TItem="Spieltag" CssClass="VereinMinWidth" Property="Verein1" Width="30%" Sortable=true Title="@Localizer["Heim"].Value">

                                        </RadzenDataGridColumn>
                                        @if (Globals.LigaNummer == 20 || Globals.LigaNummer == 21)
                                        {
                                            <RadzenDataGridColumn TItem="Spieltag" Title="" Sortable="true" Width="50px" MinWidth="50px">
                                                <Template Context="data">
                                                    <RadzenImage Path="@($"/Images/NoImage.webp")" style="width: 30px; height: 30px;" title="@data.Verein1" AlternateText="@(data.Verein1)" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                        }
                                        else
                                        {
                                             <RadzenDataGridColumn TItem="Spieltag" Title="" Sortable="true" Width="50px" MinWidth="50px">
                                                <Template Context="data">
                                                    <RadzenImage Path="@($"/Images/{data.Verein1}.webp")" style="width: 30px; height: 30px;" title="@data.Verein1" AlternateText="@(data.Verein1)" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                        }

                                       <RadzenDataGridColumn TItem="Spieltag" CssClass="FarbeTorePunkt" Property="Tore1_Nr" TextAlign="TextAlign.Center" Width="27px" Sortable=true />
                                       <RadzenDataGridColumn TItem="Spieltag" CssClass="FarbeTorePunkt" Property="Doppelpunkt" TextAlign="TextAlign.Center" Width="20px" Sortable=false />
                                       <RadzenDataGridColumn TItem="Spieltag" CssClass="FarbeTorePunkt" Property="Tore2_Nr" TextAlign="TextAlign.Center" Width="27px" Sortable=true />

                                        @if (Globals.LigaNummer == 20 || Globals.LigaNummer == 21)
                                        {
                                            <RadzenDataGridColumn TItem="Spieltag" Title="" Sortable="true" Width="50px" MinWidth="50px">
                                                <Template Context="data">
                                                    <RadzenImage Path="@($"/Images/NoImage.webp")" style="width: 30px; height: 30px;" title="@data.Verein2" AlternateText="@(data.Verein2)" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                        }
                                        else
                                        {
                                            <RadzenDataGridColumn TItem="Spieltag" Title="" Sortable="true" Width="50px" MinWidth="50px">
                                                <Template Context="data">
                                                    <RadzenImage Path="@($"/Images/{data.Verein2}.webp")" style="width: 30px; height: 30px;" title="@data.Verein2" AlternateText="@(data.Verein2)" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                        }

                                        <RadzenDataGridColumn TItem="Spieltag" CssClass="VereinMinWidth" Property="Verein2" Width="25%" Sortable=true Title="@Localizer["Auswärts"].Value" />

                                        <RadzenDataGridColumn TItem="Spieltag" FormatString="{0:dd.MM.yyyy}" Property="Datum" Width="18%" Sortable=true Title=@Localizer["Datum"].Value />
                                        <RadzenDataGridColumn TItem="Spieltag" Property="Ort" Width="30%" Sortable=true Title=@Localizer["Ort"].Value />

                                        <RadzenDataGridColumn TextAlign="TextAlign.Right" TItem="Spieltag" Property="SpieltagId" Width="80px" Filterable="false" Sortable="false">
                                            <Template Context="data">
                                                <NavLink href="@($"Ligamanager/editspieltag/{data.SpieltagId}")" title="@Localizer["Bearbeiten"].Value" class="btn btn-primary btn-sm"><div><RadzenIcon Icon="edit" title="@Localizer["Bearbeiten"].Value" /></div></NavLink>
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            </RadzenTabsItem>
                            <RadzenTabsItem Text=@Localizer["Langzeitstatistik"].Value>
                                <RadzenRow Gap="0" Style="font-weight: bold; padding: 0 0 10px 0; border-bottom: 1px solid #ccc;">
                                    <RadzenColumn Size="3" SizeXS="3">
                                        <RadzenText TextStyle="TextStyle.Body1"></RadzenText>
                                    </RadzenColumn>
                                    <RadzenColumn Size="3" SizeXS="3">
                                        <RadzenText class="rz-column-title-content" TextAlign="TextAlign.Right" TextStyle="TextStyle.Body1">Gesamt</RadzenText>
                                    </RadzenColumn>
                                    <RadzenColumn Size="3" SizeXS="3">
                                        <RadzenText class="rz-column-title-content" TextAlign="TextAlign.Right" TextStyle="TextStyle.Body1">Heim</RadzenText>
                                    </RadzenColumn>
                                    <RadzenColumn Size="3" SizeXS="3">
                                        <RadzenText class="rz-column-title-content" TextAlign="TextAlign.Right" TextStyle="TextStyle.Body1">Auswärts</RadzenText>
                                    </RadzenColumn>
                                </RadzenRow>
                                <RadzenDataList AllowVirtualization=@allowVirtualization
                                                WrapItems="@(!allowVirtualization)" AllowPaging="@(!allowVirtualization)"
                                                Data="@Statistik" TItem="Mannschaftsstatistik" PageSize="10" PagerHorizontalAlign="HorizontalAlign.Left" PageSizeText="Größe" ShowPagingSummary="true">
                                    <Template Context="Mannschaftsstatistik">
                                        <RadzenCard Style="width:100%; padding:0;">
                                            <RadzenRow Gap="0">
                                                <RadzenColumn Size="3" SizeXS="3">
                                                    <RadzenText TextAlign="TextAlign.Left" TextStyle="TextStyle.Body2">@(Mannschaftsstatistik.StatText)</RadzenText>
                                                </RadzenColumn>
                                                <RadzenColumn Size="3" SizeXS="3">
                                                    <RadzenText TextAlign="TextAlign.Right" TextStyle="TextStyle.Body2">@(Mannschaftsstatistik.Gesamt)</RadzenText>
                                                </RadzenColumn>
                                                <RadzenColumn Size="3" SizeXS="3">
                                                    <RadzenText TextAlign="TextAlign.Right" TextStyle="TextStyle.Body2">@(Mannschaftsstatistik.Heim)</RadzenText>
                                                </RadzenColumn>
                                                <RadzenColumn Size="3" SizeXS="3">
                                                    <RadzenText TextAlign="TextAlign.Right" TextStyle="TextStyle.Body2">@(Mannschaftsstatistik.Auswaerts)</RadzenText>
                                                </RadzenColumn>
                                            </RadzenRow>
                                        </RadzenCard>
                                    </Template>
                                </RadzenDataList>
                            </RadzenTabsItem>
                            <RadzenTabsItem Text=@Localizer["Serien"].Value>
                                <RadzenDataGrid AllowPaging="@(!allowVirtualization)"
                                                AllowVirtualization="@allowVirtualization"
                                                Data="@SerienStatistik"
                                                TItem="SerienStatistik"
                                                PageSize="20"
                                                ShowPagingSummary="true"                                                
                                                Responsive="true"
                                                Class="w-100">

                                    <Columns>
                                        <RadzenDataGridColumn TItem="SerienStatistik" Property="StatText" Title="Statistik" Width="40%" />
        
                                        <RadzenDataGridColumn TItem="SerienStatistik" Property="SaisonText" Title="Saison" Width="30%" />
        
                                        <RadzenDataGridColumn TItem="SerienStatistik" Title="Anzahl" Width="30%">
                                            <Template Context="item">
                                                <div style="text-align: right;">
                                                    @item.AnzahlText
                                                </div>
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                             @*  <RadzenDataGrid AllowPaging="@(!allowVirtualization)"
                                                AllowVirtualization="@allowVirtualization"
                                                Data="@SerienStatistik"
                                                TItem="SerienStatistik"
                                                PageSize="20"
                                                ShowPagingSummary="true"                
                                                Responsive="true"
                                                Class="w-100">                                                

                                                 <RadzenDataGridColumn TItem="SerienStatistik" Property="StatText" Title="ST" />
                                                 <RadzenDataGridColumn TItem="SerienStatistik" Property="SaisonText" Title="ST" />
                                                 <RadzenDataGridColumn TItem="SerienStatistik" Property="AnzahlText" Title="ST" />
                                                
                                </RadzenDataGrid> *@




                            </RadzenTabsItem>
                            <RadzenTabsItem Text=@Localizer["Pokalhistorie"].Value>
                                <RadzenDataGrid AllowPaging="@(!allowVirtualization)"
                                                AllowVirtualization="@allowVirtualization"
                                                Data="@PokalHistorieStatistik"
                                                TItem="PokalHistorieStatistik"
                                                PageSize="20"
                                                ShowPagingSummary="true"                
                                                Responsive="true"
                                                Class="w-100">
                                                <Columns>
                                                    <RadzenDataGridColumn TItem="PokalHistorieStatistik" Property="Saison" Title="Saison" Width="100px" />        
                                                    <RadzenDataGridColumn TItem="PokalHistorieStatistik" Title="Erreichte Runde" Width="150px">
                                                        <Template Context="item">
                                                            <span style="@(item.ErreichteRunde == "Finale" ? "color: green; font-weight: bold;" : ";")">
                                                                @item.ErreichteRunde
                                                            </span>
                                                        </Template>
                                                    </RadzenDataGridColumn>
        
                                                    <RadzenDataGridColumn TItem="PokalHistorieStatistik" Property="Gegner" Title="Gegner" />
        
                                                    <RadzenDataGridColumn TItem="PokalHistorieStatistik" Title="Ergebnis" Width="100px">
                                                        <Template Context="item">
                                                            @{
                                                                var ergebnis = item.Ergebnis;
                                                                var farbe = "black";

                                                                if (!string.IsNullOrWhiteSpace(ergebnis) && ergebnis.Contains(":"))
                                                                {
                                                                    var teile = ergebnis.Split(':');
                                                                    if (int.TryParse(teile[0], out var tore1) && int.TryParse(teile[1], out var tore2))
                                                                    {
                                                                        farbe = tore1 > tore2 ? "green" : tore1 < tore2 ? "red" : "black";
                                                                    }
                                                                }
                                                            }
                                                            <span style="color: @farbe; text-align:center;">@ergebnis</span>
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                </Columns>
                                </RadzenDataGrid>

                            </RadzenTabsItem>
                            <RadzenTabsItem Text="@Localizer["Siegeserien"].Value">

                                @{
                                    var seriesiegeverein = SerieSiegeVerein2
                                    .OrderByDescending(x => x.Saison)
                                    .ToList();
                                }

                                <RadzenLabel Text="Längste Siegesserien"></RadzenLabel>

                              @if (AktuelleSiegesSerie != null)
                                    {
                                        <h4>@AktuelleSiegesSerie.AnzeigenameSiege</h4>

                                        <RadzenDataGrid TItem="Spieltag"
                                                        Data="@AktuelleSiegesSerie.Spieltage"
                                                        AllowPaging="false"
                                                        AllowSorting="true">

                                            <Columns>
                                                <RadzenDataGridColumn TItem="Spieltag" Property="SpieltagNr" Title="ST" />
                                                <RadzenDataGridColumn TItem="Spieltag" FormatString="{0:dd.MM.yyyy}" Property="Datum" Width="18%" Sortable=true Title=@Localizer["Datum"].Value />
                                                <RadzenDataGridColumn TItem="Spieltag" Property="Verein1" Title=@Localizer["Verein 1"].Value Width="25%">
                                                    <Template Context="spieltag">
                                                        <span style="@(spieltag.Verein1 == Vereinsname ? "font-weight: bolder;" : "")">
                                                            @spieltag.Verein1
                                                        </span>
                                                    </Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="Spieltag" Title="" Sortable="true" Width="50px" MinWidth="50px">
                                                <Template Context="data">
                                                    <RadzenImage Path="@($"/Images/{data.Verein1}.webp")" style="width: 30px; height: 30px;" title="@data.Verein1" AlternateText="@(data.Verein1)" />
                                                </Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="Spieltag" CssClass="FarbeTorePunkt" Property="Tore1_Nr" TextAlign="TextAlign.Center" Width="27px" Sortable=true />
                                                <RadzenDataGridColumn TItem="Spieltag" CssClass="FarbeTorePunkt" Property="Doppelpunkt" TextAlign="TextAlign.Center" Width="20px" Sortable=false />
                                                <RadzenDataGridColumn TItem="Spieltag" CssClass="FarbeTorePunkt" Property="Tore2_Nr" TextAlign="TextAlign.Center" Width="27px" Sortable=true />

                                                <RadzenDataGridColumn TItem="Spieltag" Title="" Sortable="true" Width="50px" MinWidth="50px">
                                                <Template Context="data">
                                                    <RadzenImage Path="@($"/Images/{data.Verein2}.webp")" style="width: 30px; height: 30px;" title="@data.Verein2" AlternateText="@(data.Verein2)" />
                                                </Template>
                                                 </RadzenDataGridColumn>

                                                <RadzenDataGridColumn TItem="Spieltag" Property="Verein2" Title=@Localizer["Verein2"].Value Width="25%">
                                                    <Template Context="spieltag">                                                            
                                                        <span style="@(spieltag.Verein2 == Vereinsname ? "font-weight: bolder;" : "")">
                                                            @spieltag.Verein2
                                                        </span>
                                                    </Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TextAlign="TextAlign.Center" TItem="Spieltag" Property="SpieltagId" Width="80px" Filterable="false" Sortable="false">
                                                    <Template Context="data">
                                                        <NavLink href="@($"Ligamanager/editspieltag/{data.SpieltagId}")" title="@Localizer["Bearbeiten"].Value" class="btn btn-primary btn-sm"><div><RadzenIcon Icon="edit" title="@Localizer["Bearbeiten"].Value" /></div></NavLink>
                                                    </Template>
                                                </RadzenDataGridColumn>
                                            </Columns>

                                        </RadzenDataGrid>

                                        <div style="margin-top: 1rem;">
                                            <RadzenButton Text="Zurück" Icon="chevron_left" Click="@VorherigeGruppe" Disabled="@(AktuelleGruppeIndex == 0)" />
                                            <RadzenButton Text="Weiter" Icon="chevron_right" Click="@NächsteGruppe" Disabled="@(AktuelleGruppeIndex == SpieltageSerienGruppen.Count - 1)" />
                                        </div>
                                    }


                            </RadzenTabsItem>
                            <RadzenTabsItem Text="@Localizer["Niederlagenserien"].Value">

                                @{
                                    var serieniederlagenverein = SerieNiederlagenVerein2                                    
                                    .OrderByDescending(x => x.Saison)
                                    .ToList();
                                }

                                <RadzenLabel Text="Längste Niederlagenserien"></RadzenLabel>

                              @if (AktuelleNiederlagenSerie != null)
                                    {
                                        <h4>@AktuelleNiederlagenSerie.AnzeigenameNiederlagen</h4>

                                        <RadzenDataGrid TItem="Spieltag"
                                                        Data="@AktuelleNiederlagenSerie.Spieltage"
                                                        AllowPaging="false"
                                                        AllowSorting="true">

                                            <Columns>
                                                <RadzenDataGridColumn TItem="Spieltag" Property="SpieltagNr" Title="ST" />
                                                <RadzenDataGridColumn TItem="Spieltag" FormatString="{0:dd.MM.yyyy}" Property="Datum" Width="18%" Sortable=true Title=@Localizer["Datum"].Value />
                                                <RadzenDataGridColumn TItem="Spieltag" Property="Verein1" Title=@Localizer["Verein 1"].Value Width="25%">
                                                    <Template Context="spieltag">
                                                        <span style="@(spieltag.Verein1 == Vereinsname ? "font-weight: bolder;" : "")">
                                                            @spieltag.Verein1
                                                        </span>
                                                    </Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="Spieltag" Title="" Sortable="true" Width="50px" MinWidth="50px">
                                                <Template Context="data">
                                                    <RadzenImage Path="@($"/Images/{data.Verein1}.webp")" style="width: 30px; height: 30px;" title="@data.Verein1" AlternateText="@(data.Verein1)" />
                                                </Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="Spieltag" CssClass="FarbeTorePunkt" Property="Tore1_Nr" TextAlign="TextAlign.Center" Width="27px" Sortable=true />
                                                <RadzenDataGridColumn TItem="Spieltag" CssClass="FarbeTorePunkt" Property="Doppelpunkt" TextAlign="TextAlign.Center" Width="20px" Sortable=false />
                                                <RadzenDataGridColumn TItem="Spieltag" CssClass="FarbeTorePunkt" Property="Tore2_Nr" TextAlign="TextAlign.Center" Width="27px" Sortable=true />

                                                <RadzenDataGridColumn TItem="Spieltag" Title="" Sortable="true" Width="50px" MinWidth="50px">
                                                <Template Context="data">
                                                    <RadzenImage Path="@($"/Images/{data.Verein2}.webp")" style="width: 30px; height: 30px;" title="@data.Verein2" AlternateText="@(data.Verein2)" />
                                                </Template>
                                                 </RadzenDataGridColumn>

                                                <RadzenDataGridColumn TItem="Spieltag" Property="Verein2" Title=@Localizer["Verein2"].Value Width="25%">
                                                    <Template Context="spieltag">                                                            
                                                        <span style="@(spieltag.Verein2 == Vereinsname ? "font-weight: bolder;" : "")">
                                                            @spieltag.Verein2
                                                        </span>
                                                    </Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TextAlign="TextAlign.Center" TItem="Spieltag" Property="SpieltagId" Width="80px" Filterable="false" Sortable="false">
                                                    <Template Context="data">
                                                        <NavLink href="@($"Ligamanager/editspieltag/{data.SpieltagId}")" title="@Localizer["Bearbeiten"].Value" class="btn btn-primary btn-sm"><div><RadzenIcon Icon="edit" title="@Localizer["Bearbeiten"].Value" /></div></NavLink>
                                                    </Template>
                                                </RadzenDataGridColumn>
                                            </Columns>

                                        </RadzenDataGrid>

                                        <div style="margin-top: 1rem;">
                                            <RadzenButton Text="Zurück" Icon="chevron_left" Click="@VorherigeGruppeNL" Disabled="@(AktuelleGruppeIndexNL == 0)" />
                                            <RadzenButton Text="Weiter" Icon="chevron_right" Click="@NächsteGruppeNL" Disabled="@(AktuelleGruppeIndexNL == SpieltageSerienGruppenNL.Count - 1)" />
                                        </div>
                                    }


                            </RadzenTabsItem>                        
                            <RadzenTabsItem Text="@Localizer["Unentschiedenserien"].Value">

                                @{
                                    var serienunentschiedenverein = SerieUnentschiedenVerein2
                                    .OrderByDescending(x => x.AnzahlUnentschieden)
                                    .ThenBy(x => x.Saison)
                                    .ToList();
                                }

                                <RadzenLabel Text="Längste Unentschiedenserien"></RadzenLabel>

                              @if (AktuelleUnentschiedenSerie != null)
                                    {
                                        <h4>@AktuelleUnentschiedenSerie.AnzeigenameUnentschieden</h4>

                                        <RadzenDataGrid TItem="Spieltag"
                                                        Data="@AktuelleUnentschiedenSerie.Spieltage"
                                                        AllowPaging="false"
                                                        AllowSorting="true">

                                            <Columns>
                                                <RadzenDataGridColumn TItem="Spieltag" Property="SpieltagNr" Title="ST" />
                                                <RadzenDataGridColumn TItem="Spieltag" FormatString="{0:dd.MM.yyyy}" Property="Datum" Width="18%" Sortable=true Title=@Localizer["Datum"].Value />
                                                <RadzenDataGridColumn TItem="Spieltag" Property="Verein1" Title=@Localizer["Verein 1"].Value Width="25%">
                                                    <Template Context="spieltag">
                                                        <span style="@(spieltag.Verein1 == Vereinsname ? "font-weight: bolder;" : "")">
                                                            @spieltag.Verein1
                                                        </span>
                                                    </Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="Spieltag" Title="" Sortable="true" Width="50px" MinWidth="50px">
                                                <Template Context="data">
                                                    <RadzenImage Path="@($"/Images/{data.Verein1}.webp")" style="width: 30px; height: 30px;" title="@data.Verein1" AlternateText="@(data.Verein1)" />
                                                </Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="Spieltag" CssClass="FarbeTorePunkt" Property="Tore1_Nr" TextAlign="TextAlign.Center" Width="27px" Sortable=true />
                                                <RadzenDataGridColumn TItem="Spieltag" CssClass="FarbeTorePunkt" Property="Doppelpunkt" TextAlign="TextAlign.Center" Width="20px" Sortable=false />
                                                <RadzenDataGridColumn TItem="Spieltag" CssClass="FarbeTorePunkt" Property="Tore2_Nr" TextAlign="TextAlign.Center" Width="27px" Sortable=true />

                                                <RadzenDataGridColumn TItem="Spieltag" Title="" Sortable="true" Width="50px" MinWidth="50px">
                                                <Template Context="data">
                                                    <RadzenImage Path="@($"/Images/{data.Verein2}.webp")" style="width: 30px; height: 30px;" title="@data.Verein2" AlternateText="@(data.Verein2)" />
                                                </Template>
                                                 </RadzenDataGridColumn>

                                                <RadzenDataGridColumn TItem="Spieltag" Property="Verein2" Title=@Localizer["Verein2"].Value Width="25%">
                                                    <Template Context="spieltag">                                                            
                                                        <span style="@(spieltag.Verein2 == Vereinsname ? "font-weight: bolder;" : "")">
                                                            @spieltag.Verein2
                                                        </span>
                                                    </Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TextAlign="TextAlign.Center" TItem="Spieltag" Property="SpieltagId" Width="80px" Filterable="false" Sortable="false">
                                                    <Template Context="data">
                                                        <NavLink href="@($"Ligamanager/editspieltag/{data.SpieltagId}")" title="@Localizer["Bearbeiten"].Value" class="btn btn-primary btn-sm"><div><RadzenIcon Icon="edit" title="@Localizer["Bearbeiten"].Value" /></div></NavLink>
                                                    </Template>
                                                </RadzenDataGridColumn>
                                            </Columns>

                                        </RadzenDataGrid>

                                        <div style="margin-top: 1rem;">
                                            <RadzenButton Text="Zurück" Icon="chevron_left" Click="@VorherigeGruppeUS" Disabled="@(AktuelleGruppeIndexUS == 0)" />
                                            <RadzenButton Text="Weiter" Icon="chevron_right" Click="@NächsteGruppeUS" Disabled="@(AktuelleGruppeIndexUS == SpieltageSerienGruppenUS.Count - 1)" />
                                        </div>
                                    }


                            </RadzenTabsItem>
                        </Tabs>
                    </RadzenTabs>
                    <button onclick="topFunction()" id="scrollTopBtn" title="Nach oben"
                            style="display:none;position:fixed;bottom:20px;right:30px;z-index:99;
                           font-size:18px;border:none;outline:none;background-color:#333;
                           color:white;cursor:pointer;padding:10px;border-radius:4px;">
                        ↑
                    </button>

                    <div style="display:@VisibleChart" class="container">
                        <RadzenLabel Text="@Localizer["Lage"].Value" Style="font-weight:bold;" />
                        <RadzenCard style="margin-left: 0px; margin-right: 0px; margin-bottom:4px; height:600px;">
                            <canvas id="myChart" width="400" height="200"></canvas>
                        </RadzenCard>
                    </div>


                </div>
            </div>
        </div>

    }
</body>

</html>


<!-- DataTables-Skript -->
<script type="text/javascript">


       window.renderChart = () => {
        const canvas = document.getElementById("myChart");
        if (!canvas) return;
        const ctx = canvas.getContext("2d");

        const xValues = ["Siege", "Unentschieden", "Niederlagen"];
        const yValues = [10, 5, 2]; // Beispielwerte

        new Chart(ctx, {
            type: "bar",
            data: {
                labels: xValues,
                datasets: [{
                    label: "Ergebnisse",
                    backgroundColor: ["green", "yellow", "red"],
                    data: yValues
                }]
            },
            options: {
                indexAxis: 'y',
                scales: {
                    x: { beginAtZero: true },
                    y: {}
                },
                plugins: {
                    title: {
                        display: true,
                        text: "Siege - Unentschieden - Niederlagen"
                    },
                    legend: {
                        display: true
                    }
                }
            }
        });
    };

    window.renderMap = (latitude, longitude) => {
        if (!window.L) return;

        const mapContainer = document.getElementById("mapid");
        if (!mapContainer) return;

        const map = new L.Map('mapid');
        const osm = new L.TileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            minZoom: 4,
            maxZoom: 20,
            attribution: '<a href="https://openstreetmap.org ">OpenStreetMap</a>'
        });
        map.setView([latitude, longitude], 15);
        map.addLayer(osm);
    };
</script>




@code {    
    private bool _gruppenInitialZugeklappt = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_gruppenInitialZugeklappt)
        {
            _gruppenInitialZugeklappt = true;
            // Einen Tick warten, bis Grid "bereit" ist
            await Task.Delay(100);
            if (gridSpieltageSerien != null)
                await gridSpieltageSerien.CollapseAll();
            StateHasChanged(); // Neuzeichnen
        }
    }

    private void AnzeigenVereine()
    {
        _navigationManager.NavigateTo($"Ligamanager/Vereine");
    }
}


