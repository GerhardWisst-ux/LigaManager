@page "/Ligamanager/createstadion"
@page "/Ligamanager/editstadion/{Id}"
@using LigaManagement.Web.Services.Contracts;

@inherits LigaManagerManagement.Web.Pages.EditStadionListBase
@inject IStadionService _StadionService
@inject NavigationManager _navigationManager
@inject NotificationService NotificationService
@inject LigaManagerManagement.Web.Services.LigaManagerAuthenticationStateProvider _LigaManagerAuthenticationStateProvider

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.0/css/bootstrap.min.css">
    <link href='https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/themes/ui-darkness/jquery-ui.css' rel='stylesheet'>

</head>

<style type="text/css">

    .rz-chkbox-box {
    border-color: darkgray !important;
    }

    .rz-label {
    margin-left: 0px !important;
    padding-left: 20px !important;
    }

    @@media (max-width: 767px) {
    .rz-label {
    margin-left: 0px !important;
    padding-left: 0px !important;
    }
    }
</style>

@if (IsLoading)
{
    <RadzenStack AlignItems="AlignItems.Center" Class="rz-m-12" Gap="2rem">
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </RadzenStack>
}
else
{
    <div class="container">
        <div class="form-group row">
            <div class="col-sm-12">
                <RadzenCard class="m-0 rz-shadow-3" style="height:auto;">
                    <div class="d-flex flex-row">
                        <div class="card-body">
                            <span style="color:#1151f3; background-color:transparent;" class="float-right">@Localizer["Eingeloggter Benutzer"].Value: @_LigaManagerAuthenticationStateProvider.CurrentUser.Username</span>
                            <br />
                            <NavLink href="@($"Ligamanager/account/logout")" style="margin-top:8px;" title="@Localizer["Ausloggen"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="logout" /><span></span></div></NavLink>
                            <NavLink href="@($"Ligamanager/einstellungen")" style="margin-top:8px;" title="@Localizer["Einstellungen"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="settings" /><span></span></div></NavLink>
                            <NavLink href="@($"Ligamanager/info")" style="margin-top:8px;" title="@Localizer["Info"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="info" /><span></span></div></NavLink>
                            <NavLink href="@($"InfoTexteList")" style="margin-top:8px;" title="@Localizer["InfoTexte"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="help" /><span></span></div></NavLink>
                            <h2>@Titel</h2>
                        </div>
                    </div>
                </RadzenCard>
            </div>
        </div>

        <div class="col-12">
            <EditForm Model="Stadion" OnValidSubmit="UpsertStadion">
                <div class="form-group row">
                    <RadzenLabel Text="Verein" class="col-md-3 col-xs-12" Component="cboVerein">@Localizer["Verein"].Value</RadzenLabel>
                    <select id="cboVerein" style="display:inline-block;" class="form-control col-md-9 col-xs-12 dropdown" @onchange="VereinChange">
                        <option value="" selected>@Localizer["Verein auswählen"].Value</option>
                        @foreach (var verein in VereineList)
                        {
                            @if (verein.VereinID == VereinNr.ToString())
                            {
                                <option selected value="@verein.VereinID"> @verein.Vereinname1 </option>
                            }
                            else
                            {
                                <option value="@verein.VereinID"> @verein.Vereinname1 </option>
                            }
                        }
                    </select>

                    <ValidationMessage For="(()=>Stadion.VereinNr)"></ValidationMessage>
                </div>

                <div class="form-group row">
                    <DataAnnotationsValidator />
                    <RadzenLabel Text="Liganame" class="col-md-3 col-xs-12" Component="txtStadionname">@Localizer["Stadionname"].Value</RadzenLabel>
                    <InputText required id="txtStadionname" @bind-Value="Stadion.Stadionname" class="form-control  col-md-9 col-xs-12"></InputText>
                    <ValidationMessage col-md-9 col-xs-12 For="(()=>Stadion.Stadionname)"></ValidationMessage>
                </div>
                <div class="form-group row">
                    <DataAnnotationsValidator />
                    <RadzenLabel Text="Ort" class="col-md-3 col-xs-12" Component="txtOrt">@Localizer["Ort"].Value</RadzenLabel>
                    <InputText required id="txtOrt" Name="txtOrt" @bind-Value="Stadion.Ort" class="form-control  col-md-9 col-xs-12"></InputText>
                    <ValidationMessage col-md-9 col-xs-12 For="(()=>Stadion.Ort)"></ValidationMessage>
                </div>
                <div class="form-group row">
                    <DataAnnotationsValidator />
                    <RadzenLabel Text="Kapazitaet" class="col-md-3 col-xs-12" Component="txtKapazitaet">@Localizer["Kapazität"].Value</RadzenLabel>
                    <InputNumber required id="txtKapazitaet" @bind-Value="Stadion.Kapazitaet" class="form-control col-md-9 col-xs-12"></InputNumber>
                    <ValidationMessage col-md-9 col-xs-12 For="(()=>Stadion.Kapazitaet)"></ValidationMessage>
                </div>
                <div class="form-group row">
                    <DataAnnotationsValidator />
                    <RadzenLabel Text="JahrVon" class="col-md-3 col-xs-12" Component="txtJahrVon">@Localizer["Jahr Von"].Value</RadzenLabel>
                    <InputNumber required id="txtJahrVon"  @bind-Value="Stadion.JahrVon" class="form-control  col-md-9 col-xs-12"></InputNumber>
                    <ValidationMessage col-md-9 col-xs-12 For="(()=>Stadion.JahrVon)"></ValidationMessage>
                </div>
                <div class="form-group row">
                    <DataAnnotationsValidator />
                    <RadzenLabel Text="JahrBis" class="col-md-3 col-xs-12" Component="txtJahrBis">@Localizer["Jahr bis"].Value</RadzenLabel>
                    <InputNumber required id="txtJahrBis" @bind-Value="Stadion.JahrBis" class="form-control  col-md-9 col-xs-12"></InputNumber>
                    <ValidationMessage col-md-9 col-xs-12 For="(()=>Stadion.JahrBis)"></ValidationMessage>
                </div>

                <div class="form-group row">
                    <RadzenButton title="@Localizer["Speichert Stadion ab"].Value" style="margin-left:5px;" id="btnSpeichern" Click="UpsertStadion" class="btn btn-primary" Text="@Localizer["Speichern"].Value">
                        <span class="glyphicon glyphicon-save"></span>@Localizer["Speichern"].Value
                    </RadzenButton>
                    <RadzenButton title="@Localizer["Löscht Liga"].Value" style="margin-left:5px;" id="btnDelete" Click="Confirm" class="btn btn-danger" Text="@Localizer["Löschen"].Value">
                        <span class="glyphicon glyphicon-remove"></span>@Localizer["Löschen"].Value
                    </RadzenButton>
                    <RadzenButton title="@Localizer["Zurück zu Stadien"].Value" style="margin-left:5px;" Click="Zurueck_Click" id="btnZurueck" class="btn btn-secodary" Text="@Localizer["Zurück"].Value">

                    </RadzenButton>
                </div>
            </EditForm>
        </div>
    </div>
}


@code {
    [Parameter]
    public string Id { get; set; }
    private Stadion Stadion { get; set; } = new Stadion();
    private string Titel { get; set; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (Id == "0" || Id is null)
            {
                Id = "0";
                Titel = @Localizer["Neuanlage Stadion"].Value;
                IsLoading = false;
                Stadion = await _StadionService.GetStadion(Convert.ToInt32(Id));
                StateHasChanged();
            }
            else
            {
                var stadion = await _StadionService.GetStadion(Convert.ToInt32(Id));
                VereinNr = stadion.VereinNr;
                Titel = @Localizer["Bearbeiten Stadion"].Value;
                await LoadStadion();
            }
        }
    }

    private async Task LoadStadion()
    {
        IsLoading = true;
        Stadion = await _StadionService.GetStadion(Convert.ToInt32(Id));
        IsLoading = false;
        StateHasChanged();
    }
    private async Task UpsertStadion()
    {
        bool bError = false;

        if (Globals.CurrentRole == "USER" || Globals.CurrentRole == "GUEST")
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = @Titel, Detail = "Sie haben nicht das Recht Stadien zu ändern bzw. neu anzulegen." });
            return;
        }

        if ((VereinNr == 0))
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = @Titel, Detail = "Verein nicht ausgewählt. Speichern nicht möglich." });
            bError = true;
        }
        else if ((string.IsNullOrEmpty(Stadion.Stadionname)))
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = @Titel, Detail = "Stadionname nicht angegeben. Speichern nicht möglich." });
            bError = true;
        }
        else if ((string.IsNullOrEmpty(Stadion.Ort)))
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = @Titel, Detail = "Ort nicht angegeben. Speichern nicht möglich." });
            bError = true;
        }
        else if ((Stadion.Kapazitaet == 0))
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = @Titel, Detail = "Kapazität nicht angegeben. Speichern nicht möglich." });
            bError = true;
        }
        else if ((Stadion.JahrVon == 0))
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = @Titel, Detail = "Jahr Von nicht angegeben. Speichern nicht möglich." });
            bError = true;
        }
        else if ((Stadion.JahrBis == 0))
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = @Titel, Detail = "Jahr Bis nicht angegeben. Speichern nicht möglich." });
            bError = true;
        }

        if (bError == true)
            return;

        if (Id == "0")
        {
            var stadien = await _StadionService.GetStadien();
            List<Stadion> stadienList = stadien.OrderBy(x => x.VereinNr).ToList();
            int iMaxLigaNummer = stadienList.Max(x => x.Id) + 1;

            Stadion.VereinNr = VereinNr;
            Stadion.JahrVonDate = new DateTime(Stadion.JahrVon, 7, 1);
            Stadion.JahrBisDate = new DateTime(Stadion.JahrBis, 6, 30);
            await _StadionService.CreateStadion(Stadion);
        }
        else
        {
            var stadien = await _StadionService.GetStadien();
            Stadion.VereinNr = VereinNr;
            Stadion.JahrVonDate = new DateTime(Stadion.JahrVon,7, 1);
            Stadion.JahrBisDate = new DateTime(Stadion.JahrBis, 6, 30);
            await _StadionService.UpdateStadion(Stadion);
        }
        NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Info,
                Summary = Localizer["Bearbeiten Stadion"].Value,
                Detail = Localizer["Abgespeichert"].Value
            });
        // _navigationManager.NavigateTo("ligen");
    }
    protected async Task<bool> Confirm()
    {
        string message = string.Empty;

        if (Globals.CurrentRole == "USER" || Globals.CurrentRole == "GUEST")
        {
            message = "Sie können dieses Stadion nicht löschen?";
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info,  Summary = "Löschen Stadion:" + message, Detail = "Löschen" });
            return false;
        }
        message = Localizer["MessageDelete"].Value;

        var result = await jsr.InvokeAsync<bool>("confirm", new[] { message });

        if (result)
        {
            await _StadionService.DeleteStadion(Convert.ToInt32(Id));
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = Localizer["Löschen Stadion"].Value, Detail = Localizer["Gelöscht"].Value });
        }

        return false;
    }

    private void Zurueck_Click()
    {
        _navigationManager.NavigateTo("/StadionList");
    }
}
