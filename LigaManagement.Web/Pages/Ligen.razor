@page "/Ligamanager/ligen"
@using LigaManagerManagement.Web.Pages;
@inject LigaManagerManagement.Web.Services.LigaManagerAuthenticationStateProvider _LigaManagerAuthenticationStateProvider
@inherits LigenListBase
@inject NavigationManager _navigationManager

@attribute [Authorize]

<head>

</head>

<script>
    function scrollToTop() {
        window.scrollTo(0, 0);
    }
</script>

<style type="text/css">

    .rz-datatable tr {
        min-height: 8%;
        word-break: break-all;
    }

    tr.separated td {
        /* set border style for separated rows */
        border-bottom: 1px solid black;
    }

    table {
        /* make the border continuous (without gaps between columns) */
        border-collapse: collapse;
    }

    .rz-datatable td {
        padding: 2.5px;
    }
</style>

@if (IsLoading)
{
    <RadzenStack AlignItems="AlignItems.Center" Class="rz-m-12" Gap="2rem">
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </RadzenStack>
}
else
{
    <div class="container">

        <RadzenCard class="m-0 rz-shadow-3" style="height:120px;">
            <div class="d-flex flex-row">
                <div class="card-body">
                    <span style="color:#1151f3; background-color:transparent;" class="float-right">@Localizer["Eingeloggter Benutzer"].Value: @_LigaManagerAuthenticationStateProvider.CurrentUser.Username</span>
                    <br />
                    <NavLink href="@($"Ligamanager/account/logout")" style="margin-top:8px;" title="@Localizer["Ausloggen"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="logout" /><span></span></div></NavLink>
                    <NavLink href="@($"Ligamanager/einstellungen")" style="margin-top:8px;" title="@Localizer["Einstellungen"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="settings" /><span></span></div></NavLink>
                    <NavLink href="@($"Ligamanager/info")" style="margin-top:8px;" title="@Localizer["Info"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="info" /><span></span></div></NavLink>
                    <NavLink href="@($"InfoTexteList")" style="margin-top:8px;" title="@Localizer["InfoTexte"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="help" /><span></span></div></NavLink>
                    <h2 style="display:inline-block;">@Localizer["Ligen"].Value</h2>
                    <span class="ml-3">
                        <RadzenButton Click=@(args => OnClick("Primary icon button")) Icon="add_circle_outline" title="@Localizer["Neuanlage Liga"].Value" ButtonStyle="ButtonStyle.Primary" />
                    </span>
                </div>
            </div>
        </RadzenCard>


        <RadzenCard class="my-4" style="display: flex; align-items: center; gap: 0.5rem">
            <RadzenSelectBar @bind-Value="@Density" TextProperty="Text" ValueProperty="Value"
                             Data="@(Enum.GetValues(typeof(Density)).Cast<Density>().Select(t => new { Text = $"{t}", Value = t }))" Size="ButtonSize.Medium" />
        </RadzenCard>

        <div class="form-group row">
            <div class="col-sm-12">
                <RadzenDataGrid @ref="grid" Data="@LigenList" class="table table-striped" FilterMode="FilterMode.Simple" PageSize="30"
                                AllowPaging="true" AllowSorting="true" Responsive=true Density="@Density" AllowFiltering="true"
                                TItem="Liga" Visible="true" AllowColumnResize="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                LogicalFilterOperator="LogicalFilterOperator.Or">
                    <Columns>
                        <RadzenDataGridColumn TItem="Liga" Property="Id" Title="Id" Visible=false>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Liga" Property="Id" TextAlign="TextAlign.Right" Width="8%" Sortable="false">
                            <HeaderTemplate>
                                <div style="padding: 4px 8px;">
                                    @Localizer["ID"].Value
                                </div>
                            </HeaderTemplate>
                            <Template Context="data">
                                <div style="padding: 4px 8px;">
                                    @data.Id
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Liga" Property="Liganame" TextAlign="TextAlign.Left" Width="25%" Sortable="true">
                            <HeaderTemplate>
                                <div style="padding: 4px 8px;">
                                    @Localizer["Liganame"].Value
                                </div>
                            </HeaderTemplate>
                            <Template Context="data">
                                <div style="padding: 4px 8px;">
                                    @data.Liganame
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Liga" Property="Saisonen" TextAlign="TextAlign.Right" Width="10%" Sortable="true">
                            <HeaderTemplate>
                                <div style="padding: 4px 8px;">
                                    @Localizer["Saisonen"].Value
                                </div>
                            </HeaderTemplate>
                            <Template Context="data">
                                <div style="padding: 4px 8px;">
                                    @data.Saisonen
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Liga" Property="Verband" TextAlign="TextAlign.Left" Width="15%" Sortable="true">
                            <HeaderTemplate>
                                <div style="padding: 4px 8px;">
                                    @Localizer["Verband"].Value
                                </div>
                            </HeaderTemplate>
                            <Template Context="data">
                                <div style="padding: 4px 8px;">
                                    @data.Verband
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Liga" Property="Erstaustragung" Width="150px" TextAlign="TextAlign.Center" Filterable="false" Sortable=true>
                            <HeaderTemplate>
                                <div style="padding: 4px 8px;">
                                    @Localizer["Erstaustragung"].Value
                                </div>
                            </HeaderTemplate>
                            <Template Context="data">
                                <div style="padding: 4px 8px;">
                                    @data.Erstaustragung?.ToString("dd.MM.yyyy")
                                </div>
                            </Template>                            
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Liga" Property="Aktiv" TextAlign="TextAlign.Center" Width="7%" Sortable="false">
                            <HeaderTemplate>
                                <div style="padding: 4px 8px;">
                                    @Localizer["Aktiv"].Value
                                </div>
                            </HeaderTemplate>
                            <Template Context="data">
                                <RadzenCheckBox @bind-Value=@data.Aktiv TValue="bool" Name="chkAktiv" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Liga" Property="EMWM" TextAlign="TextAlign.Center" Width="7%" Sortable="false">
                            <HeaderTemplate>
                                <div style="padding: 4px 8px;">
                                    @Localizer["EMWM"].Value
                                </div>
                            </HeaderTemplate>
                            <Template Context="data">
                                <RadzenCheckBox @bind-Value=@data.EMWM TValue="bool" Name="chkEMWM" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TextAlign="TextAlign.Center" TItem="Liga" Property="Id" Width="100px" Filterable="false" Sortable="false">
                            <Template Context="data">
                                <NavLink href="@($"Ligamanager/editliga/{data.Id}")" title="@Localizer["Bearbeiten"].Value" class="btn btn-primary btn-sm"><div><RadzenIcon Icon="edit" title="@Localizer["Bearbeiten"].Value" /></div></NavLink>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                    <FooterTemplate>
                    </FooterTemplate>
                    <FooterTemplate>
                        @Localizer["Anzahl Ligen"].Value: <b>@LigenList.Count()</b>
                    </FooterTemplate>
                </RadzenDataGrid>
                <RadzenRow Wrap="FlexWrap.NoWrap" Gap="10px" class="rz-white">
                    <RadzenColumn Offset="11" Style="text-align:right;">
                        <button onclick="topFunction()" id="btnTop" class="btn btn-primary btn-sm" title="@Localizer["Nach oben"].Value" style='font-size:12px'><div><RadzenIcon Icon="open_in_browser" /><span></span></div></button>
                    </RadzenColumn>
                </RadzenRow>
            </div>
        </div>
    </div>
    <script>

             window.onscroll = function () { scrollFunction(); };

        function scrollFunction() {
            const mybutton = document.getElementById("btnTop");
            if (!mybutton) return;  // Sicherstellen, dass Element da ist

            if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
                mybutton.style.display = "block";
            } else {
                mybutton.style.display = "none";
            }
        }

        function topFunction() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
}
@code {
    private void OnClick(string text)
    {
        _navigationManager.NavigateTo("Ligamanager/createliga");
    }
}