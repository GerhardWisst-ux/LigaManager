@page "/Ligamanager/CreateInfoText"
@page "/Ligamanager/EditInfoText/{Id}"
@using LigaManagement.Web.Services.Contracts;

@inherits LigaManagerManagement.Web.Pages.EditInfoTextListBase
@inject IInfoTexteService _InfoTextService
@inject NavigationManager _navigationManager
@inject NotificationService NotificationService
@inject LigaManagerManagement.Web.Services.LigaManagerAuthenticationStateProvider _LigaManagerAuthenticationStateProvider

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.0/css/bootstrap.min.css">
    <link href='https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/themes/ui-darkness/jquery-ui.css' rel='stylesheet'>

</head>

<style type="text/css">

    .rz-chkbox-box {
        border-color: darkgray !important;
    }

    .rz-label {
        margin-left: 0px !important;
        padding-left: 20px !important;
    }

    @@media (max-width: 767px) {
        .rz-label {
            margin-left: 0px !important;
            padding-left: 0px !important;
        }
    }
</style>

@if (IsLoading)
{
    <RadzenStack AlignItems="AlignItems.Center" Class="rz-m-12" Gap="2rem">
        <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </RadzenStack>
}
else
{
    <div class="container">
        <div class="form-group row">
            <div class="col-sm-12">
                <RadzenCard class="m-0 rz-shadow-3" style="height:auto;">
                    <div class="d-flex flex-row">
                        <div class="card-body">
                            <span style="color:#1151f3; background-color:transparent;" class="float-right">@Localizer["Eingeloggter Benutzer"].Value: @_LigaManagerAuthenticationStateProvider.CurrentUser.Username</span>
                            <br />
                            <NavLink href="@($"Ligamanager/account/logout")" style="margin-top:8px;" title="@Localizer["Ausloggen"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="logout" /><span></span></div></NavLink>
                            <NavLink href="@($"Ligamanager/einstellungen")" style="margin-top:8px;" title="@Localizer["Einstellungen"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="settings" /><span></span></div></NavLink>
                            <NavLink href="@($"Ligamanager/info")" style="margin-top:8px;" title="@Localizer["Info"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="info" /></div></NavLink>
                            <NavLink href="@($"InfoTexteList")" style="margin-top:8px;" title="@Localizer["InfoTexte"].Value" class="btn btn-primary btn-sm float-right mr-2"><div><RadzenIcon Icon="help" /></div></NavLink>
                            <h2>@Titel</h2>
                        </div>
                    </div>
                </RadzenCard>
            </div>
        </div>

        <div class="col-12">
            <EditForm Model="InfoTexte" OnValidSubmit="UpsertInfoText">
                <div class="form-group row">
                    <RadzenLabel Text="VereinNr" class="col-md-3 col-xs-12" Component="txtTitel">@Localizer["Verein"].Value</RadzenLabel>
                    <select id="cboVerein" style="display:inline-block;width:180px;" class="form-control dropdown" @onchange="VereinChange">
                        <option value="" selected>@Localizer["Verein auswählen"].Value</option>
                        @foreach (var verein in VereineList.OrderBy(o => o.Vereinname1))
                        {
                            @if (verein.VereinID == VereinNr.ToString())
                            {
                                <option selected value="@verein.VereinID"> @verein.Vereinname1 </option>
                            }
                            else
                            {
                                <option value="@verein.VereinID"> @verein.Vereinname1 </option>
                            }
                        }
                    </select>
                    <label title="@Localizer["Bitte Verein wählen"].Value" style="display:@DisplayErrorVerein;color:red;" id="lblErrorLiga">@Localizer["Bitte Verein wählen"].Value</label>
                </div>
                <div class="form-group row">
                    <DataAnnotationsValidator />
                    <RadzenLabel Text="Titel" class="col-md-3 col-xs-12" Component="txtTitel">@Localizer["Titel"].Value</RadzenLabel>
                    <InputText required id="txtTitel" @bind-Value="InfoTexte.Title" class="form-control col-md-9 col-xs-12"></InputText>
                    <ValidationMessage For="(() => InfoTexte.Title)"
                                       class="col-md-9 offset-md-3 text-danger pl-3">
                    </ValidationMessage>
                </div>

                <div class="form-group row">
                    <DataAnnotationsValidator />
                    <RadzenLabel Text="Inhalt" class="col-md-3 col-xs-12" Component="txtInhalt">@Localizer["Inhalt"].Value</RadzenLabel>
                    <RadzenTextArea style="height:120px;" mu required id="Inhalt" Name="Inhalt" @bind-Value="InfoTexte.NewsContent" class="form-control col-md-9 col-xs-12"></RadzenTextArea>
                    <ValidationMessage For="(() => InfoTexte.NewsContent)"
                                       class="col-md-9 offset-md-3 text-danger pl-3">
                    </ValidationMessage>
                </div>
                @if (!(Id == "0" || Id is null))
                {
                    <div class="form-group row">
                        <DataAnnotationsValidator />
                        <RadzenLabel Text="PublishedAt" class="col-md-3 col-xs-12" Component="txtPublishedAt">@Localizer["Erstellt am"].Value</RadzenLabel>
                        <InputDate required id="txtPublishedAt" style="width:180px;" @bind-Value="InfoTexte.PublishedAt" class="form-control"></InputDate>
                        <ValidationMessage For="(() => InfoTexte.PublishedAt)"
                                           class="col-md-9 offset-md-3 text-danger pl-3">
                        </ValidationMessage>
                    </div>
                }
                <div class="form-group row">
                    <RadzenButton title="@Localizer["Speichert InfoText ab"].Value" style="margin-left:5px;" id="btnSpeichern" Click="UpsertInfoText" class="btn btn-primary" Text="@Localizer["Speichern"].Value">
                        <span class="glyphicon glyphicon-save"></span>@Localizer["Speichern"].Value
                    </RadzenButton>
                    <RadzenButton title="@Localizer["Löscht Infotext"].Value" style="margin-left:5px;" id="btnDelete" Click="Confirm" class="btn btn-danger" Text="@Localizer["Löschen"].Value">
                        <span class="glyphicon glyphicon-remove"></span>@Localizer["Löschen"].Value
                    </RadzenButton>
                    <RadzenButton title="@Localizer["Zurück zur Übersicht Infotexte"].Value" style="margin-left:5px;" Click="Zurueck_Click" id="btnZurueck" class="btn btn-secodary" Text="@Localizer["Zurück"].Value">
                    </RadzenButton>
                </div>
            </EditForm>
        </div>
    </div>
}


@code {

    private async Task UpsertInfoText()
    {
        bool bError = false;

        if (Globals.CurrentRole == "USER" || Globals.CurrentRole == "GUEST")
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = @Titel, Detail = "Sie haben nicht das Recht Stadien zu ändern bzw. neu anzulegen." });
            return;
        }

        if ((string.IsNullOrEmpty(InfoTexte.Title)))
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = @Titel, Detail = "Titel nicht angegeben. Speichern nicht möglich." });
            bError = true;
        }
        else if ((string.IsNullOrEmpty(InfoTexte.NewsContent)))
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = @Titel, Detail = "Inhalt nicht angegeben. Speichern nicht möglich." });
            bError = true;
        }
        else if (VereinNr == 0)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = @Titel, Detail = "Verein nicht ausgewählt. Speichern nicht möglich." });
            bError = true;
        }

        if (bError == true)
            return;

        if (Id == "0")
        {
            var texte = await _InfoTextService.GetTexte();
            List<InfoText> texteList = texte.OrderBy(x => x.PublishedAt).ToList();

            InfoTexte.SaisonID = Globals.SaisonID;
            InfoTexte.LigaID = Globals.LigaID;
            InfoTexte.PublishedAt = new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.Now.Day, DateTime.Now.Hour, DateTime.Now.Minute, DateTime.Now.Second);
            InfoTexte.ChangedAt = new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.Now.Day, DateTime.Now.Hour, DateTime.Now.Minute, DateTime.Now.Second);
            InfoTexte.VereinID = VereinNr;
            await _InfoTextService.CreateText(InfoTexte);
        }
        else
        {
            var texte = await _InfoTextService.GetTexte();
            List<InfoText> texteList = texte.OrderBy(x => x.PublishedAt).ToList();
            InfoTexte.SaisonID = Globals.SaisonID;
            InfoTexte.LigaID = Globals.LigaID;
            InfoTexte.ChangedAt = new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.Now.Day, DateTime.Now.Hour, DateTime.Now.Minute, DateTime.Now.Second);
            InfoTexte.VereinID = VereinNr;
            await _InfoTextService.UpdateText(InfoTexte);
        }

        NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Info,
                Summary = Localizer["Bearbeiten Infoext"].Value,
                Detail = Localizer["Abgespeichert"].Value
            });
    }
    protected async Task<bool> Confirm()
    {
        string message = string.Empty;

        if (Globals.CurrentRole == "USER" || Globals.CurrentRole == "GUEST")
        {
            message = "Sie können diesen InfoText nicht löschen?";
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "Löschen Infotext:" + message, Detail = "Löschen" });
            return false;
        }
        message = Localizer["MessageDelete"].Value;

        var result = await jsr.InvokeAsync<bool>("confirm", new[] { message });

        if (result)
        {
            await _InfoTextService.DeleteText(Convert.ToInt32(Id));
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = Localizer["Löschen Infotext"].Value, Detail = Localizer["Gelöscht"].Value });
        }

        return false;
    }

    private void Zurueck_Click()
    {
        _navigationManager.NavigateTo("/InfoTexteList");
    }
}
