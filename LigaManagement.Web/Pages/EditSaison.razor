@code {

    public string Titel { get; set; }
    private string saison;
    private string savedSaison;

    private string liganame;
    private string savedliganame;

    private string aboutMe;
    private string savedAboutMe;


    private void OnChange()
    {
        saison = savedSaison;
        liganame = savedliganame;

    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (SaisonId == null)
            {
                //Neuanlage
                SaisonId = "0";
                Titel = @Localizer["Neuanlage Saison"].Value;
                IsLoading = false;
            }
            else
            {
                //Bearbeiten
                Titel = @Localizer["Bearbeiten Saison"].Value;
                await LoadSaison();
            }
        }
    }

    private async Task LoadSaison()
    {
        IsLoading = true;
        Saison = await _SaisonenService.GetSaison(Convert.ToInt32(SaisonId));
        IsLoading = false;
        StateHasChanged();
    }

    private void CanChange(StepsCanChangeEventArgs args)
    {
        if ((Saison.Saisonname == "" || Saison.Saisonname == null))
        {
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = Titel, Detail = "Sie haben keinen gültigen Saisonnamen angegeben.Fortfahren nicht möglich." });
            return;
        }

        if ((Liganame == "" || Saison.Liganame == null))
        {
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = Titel, Detail = "Sie haben keinen gültigen Liganamen angegeben.Fortfahren nicht möglich." });
            return;
        }

        if ((Saison.AnzahlVereine < 8))
        {
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = Titel, Detail = "Anzahl der Vereine für eine Saison muß mindestens 8 sein." });
            return;
        }

        if ((Saison.Abgeschlossen == false && Saison.Aktuell == false))
        {
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = Titel, Detail = "Entweder Abgeschlossen oder Aktuell muß angegeben werden.Fortfahren nicht möglich." });
            return;
        }


        if (args.SelectedIndex == 1)
        {
            if ((SelectedVereine.Count() != Saison.AnzahlVereine))
            {
                _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = Titel, Detail = "Es sind keine " + Saison.AnzahlVereine + " Vereine angegeben. Speichern nicht möglich." });
                return;
            }
        }
    }

    private void SaveGrunddaten()
    {
        bool bError = false;

        if ((Saison.Saisonname == "" || Saison.Saisonname == null))
        {
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = Titel, Detail = "Sie haben keinen gültigen Saisonnamen angegeben.Fortfahren nicht möglich." });
            bError = true;
        }

        if ((Saison.Liganame == "" || Saison.Liganame == null))
        {
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = Titel, Detail = "Sie haben keinen gültigen Liganamen angegeben.Fortfahren nicht möglich." });
            bError = true;
        }

        else if ((Saison.AnzahlVereine < 10 && Saison.AnzahlVereine > 30))
        {
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = Titel, Detail = "AnzahlVereine muß zwischen 10 und 30 liegen.Fortfahren nicht möglich." });
            bError = true;
        }

        else if ((Saison.Abgeschlossen == false && Saison.Aktuell == false))
        {
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = Titel, Detail = "Entweder Abgeschlossen oder Aktuell muß angegeben werden.Fortfahren nicht möglich." });
            bError = true;
        }

        savedSaison = saison;
        savedliganame = liganame;        
    }          

    private async void SaveSaison()
    {
        if ((SelectedVereine.Count() != Saison.AnzahlVereine))
        {
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = Titel, Detail = "Es sind keine " + Saison.AnzahlVereine + " Vereine angegeben. Speichern nicht möglich." });
            return;
        }
        
        LigaManagerManagement.Models.Saison SaisonenServiceCreated;

        var liga = await LigaService.GetLiga(LigaID);
        var land = await LandService.GetLand(liga.LandID);
        Saison.LandID = land.Id;

        if (SaisonId == "0" && SaisonId is null)
        {
            Saison.SaisonID = 0;
            Saison.LigaID = LigaID;
            Saison.Ligahoehe = LigaID;
            Saison.Liganame = Liganame;            
        }
        else
        {
            Saison.SaisonID = Convert.ToInt32(SaisonId);            
            Saison.Ligahoehe = Saison.LigaID;
            Saison.Liganame = Saison.Liganame;            
        }     

        // ToDo Transaction
        SaisonenServiceCreated = await SaisonenService.UpdateSaison(Saison);

        List<VereineSaison> lstVereineSaison = new List<VereineSaison>();
                
        await _VereineSaisonService.DeleteVereineSaison(Saison.SaisonID);

        if (SaisonenServiceCreated.SaisonID > 0)
        {
            for (int i = 0; i <= SelectedVereine.Count - 1; i++)
            {
                VereineSaison item = new VereineSaison();

                item.Id = i + 1;
                item.VereinNr = Convert.ToInt32(SelectedVereine[i].VereinID);
                item.LandID = SaisonenServiceCreated.LandID;
                item.SaisonID = SaisonenServiceCreated.SaisonID;
                item.LigaID = Saison.LigaID;
                lstVereineSaison.Add(item);
            }

            var resultCreateVereineSaison = await _VereineSaisonService.CreateVereineSaison(lstVereineSaison);

            if (resultCreateVereineSaison != null)
                                   
                _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = Titel, Detail = "Saison erfolgreich abgespeichert." });                
            else                
                _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = Titel, Detail = "Fehler beim Abspeichern der Saison." });
                
            //_navigationManager.NavigateTo("/Ligamanager/saisonen");
        }
        else
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Neuanlage Saison SaisonenServiceCreated.SaisonID ist null:", Detail = "Saison konnte nicht angelegt werden." });
    }

    private void GoBack()
    {
        _navigationManager.NavigateTo($"Ligamanager/saisonen", true);
    }

     protected async Task<bool> Confirm()
    {
        string message = string.Empty;

        if (Globals.CurrentRole == "USER" || Globals.CurrentRole == "GUEST")
        {
            message = "Sie können diese Saison nicht löschen!";
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Löschen Saison", Detail = "Löschen" });
            return false;
        }
        message = Localizer["MessageDelete"].Value;

        var result = await jsr.InvokeAsync<bool>("confirm", new[] { message });

        if (result)
        {
            await SaisonenService.DeleteSaison(Convert.ToInt32(SaisonId));
            _NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = Localizer["Löschen Saison"].Value, Detail = Localizer["Gelöscht"].Value });
        }

        return false;
    }    
